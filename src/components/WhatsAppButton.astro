---
interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = "251920009100",
  message = "Hello Abyssinian Tour Operator, I would like to inquire about an Ethiopian tour."
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<!-- Floating WhatsApp Contact Button (Bottom-Left as Requested) -->
<aside class="floating-whatsapp-wrap" aria-label="WhatsApp Quick Contact">
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="whatsapp-float-btn" 
    aria-label="Chat with Abyssinian Tour Operator on WhatsApp (+251 920 009 100)"
  >
    <div class="whatsapp-icon-circle">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z" fill="#25D366"/>
        <path d="M17.52 14.33C17.22 14.18 15.75 13.45 15.47 13.35C15.2 13.25 15 13.2 14.81 13.5C14.61 13.79 14.04 14.47 13.87 14.67C13.7 14.86 13.52 14.89 13.23 14.74C12.93 14.59 11.99 14.28 10.87 13.29C10.01 12.51 9.42 11.56 9.25 11.26C9.09 10.97 9.23 10.81 9.38 10.66C9.51 10.53 9.68 10.31 9.82 10.14C9.97 9.97 10.02 9.85 10.12 9.65C10.22 9.45 10.17 9.28 10.09 9.13C10.02 8.98 9.42 7.51 9.18 6.91C8.94 6.33 8.7 6.41 8.52 6.4C8.35 6.39 8.16 6.39 7.96 6.39C7.76 6.39 7.44 6.46 7.17 6.76C6.9 7.05 6.13 7.78 6.13 9.24C6.13 10.71 7.2 12.12 7.35 12.32C7.5 12.52 9.45 15.52 12.44 16.81C13.15 17.12 13.71 17.3 14.14 17.44C14.86 17.67 15.51 17.64 16.03 17.56C16.61 17.47 17.82 16.83 18.07 16.12C18.32 15.42 18.32 14.82 18.25 14.7C18.17 14.58 17.98 14.5 17.68 14.35L17.52 14.33Z" fill="#FFFFFF"/>
      </svg>
    </div>
    <span class="whatsapp-float-label">WhatsUp Us</span>
  </a>
</aside>

<style>
  .floating-whatsapp-wrap {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 990;
    pointer-events: auto;
  }

  .whatsapp-float-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: #25D366;
    color: #FFFFFF !important;
    padding: 0.45rem 1rem 0.45rem 0.45rem;
    border-radius: 9999px;
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.45), 0 2px 6px rgba(0, 0, 0, 0.15);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.3px;
  }

  .whatsapp-float-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.6), 0 4px 10px rgba(0, 0, 0, 0.2);
    color: #FFFFFF !important;
  }

  .whatsapp-icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: #FFFFFF;
    flex-shrink: 0;
  }

  .whatsapp-float-label {
    padding-right: 0.25rem;
    white-space: nowrap;
    line-height: 1;
  }

  @media (max-width: 680px) {
    .floating-whatsapp-wrap {
      bottom: 18px;
      left: 16px;
    }

    .whatsapp-float-label {
      display: none;
    }

    .whatsapp-float-btn {
      padding: 0;
      border-radius: 50%;
    }

    .whatsapp-icon-circle {
      width: 50px;
      height: 50px;
    }
  }
</style>

