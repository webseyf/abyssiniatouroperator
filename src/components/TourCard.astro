---
import type { Tour } from '../data/tours';

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;
---

<article class="tour-card" data-pillar={tour.pillarId} data-title={tour.title.toLowerCase()}>
  <div class="card-media">
    <img 
      src={tour.cardImage} 
      alt={tour.title} 
      loading="lazy" 
      class="tour-img" 
      width="400" 
      height="250"
    />
    <div class="card-duration-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <span>{tour.duration}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-category-line">
      <span class="category-tag">{tour.category}</span>
    </div>

    <h3 class="card-title">
      <a href={`/tours/${tour.slug}`}>{tour.title}</a>
    </h3>

    <div class="card-route">
      <span class="route-label">Route:</span>
      <span class="route-text">{tour.routing}</span>
    </div>

    <div class="card-highlights">
      <span class="highlights-title">Key Highlights:</span>
      <ul class="highlights-list">
        {tour.highlights.slice(0, 3).map(h => (
          <li>{h}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="card-footer">
    <a href={`/tours/${tour.slug}`} class="btn-card-view">
      [ View Itinerary ]
    </a>
    <button 
      type="button" 
      class="btn btn-gold btn-sm js-open-quote-modal" 
      data-tour={tour.title}
    >
      Get Quote
    </button>
  </div>
</article>

<style>
  .tour-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-sand-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tour-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold);
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 200px;
    background-color: #2F2720;
    overflow: hidden;
  }

  .tour-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .tour-card:hover .tour-img {
    transform: scale(1.05);
  }

  .card-duration-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(27, 23, 19, 0.85);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .card-body {
    padding: 1.25rem 1.25rem 1rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-category-line {
    margin-bottom: 0.45rem;
  }

  .category-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-gold-deep);
  }

  .card-title {
    font-size: 1.15rem;
    line-height: 1.3;
    margin-bottom: 0.65rem;
  }

  .card-title a {
    color: var(--color-primary-dark);
  }

  .card-title a:hover {
    color: var(--color-gold-deep);
  }

  .card-route {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background-color: var(--color-sand-bg);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.85rem;
    line-height: 1.4;
    border: 1px solid rgba(222, 205, 183, 0.6);
  }

  .route-label {
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-right: 0.3rem;
  }

  .card-highlights {
    font-size: 0.82rem;
    color: var(--color-text-main);
    flex: 1;
  }

  .highlights-title {
    font-weight: 700;
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  .highlights-list {
    list-style: disc;
    padding-left: 1.1rem;
    color: var(--color-text-muted);
  }

  .highlights-list li {
    margin-bottom: 0.3rem;
    line-height: 1.35;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem 1.1rem 1.25rem;
    border-top: 1px solid var(--color-sand-border);
    background-color: #FCFAF6;
  }

  .btn-card-view {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .btn-card-view:hover {
    color: var(--color-gold-deep);
  }
</style>

