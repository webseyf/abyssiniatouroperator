---
import { siteConfig } from '../config/site';
import { tourPillars } from '../data/tours';
---

<footer class="site-footer">
  <!-- Top Accreditation Strip -->
  <div class="footer-accreditation">
    <div class="container footer-accreditation-inner">
      <div class="accred-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>Ministry of Tourism Accredited Inbound DMC</span>
      </div>
      <div class="accred-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        <span>100% Direct Heavy-Duty Toyota 4x4 Fleet Ownership</span>
      </div>
      <div class="accred-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span>Guaranteed 12-Hour B2B Proposal Turnaround</span>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="footer-main">
    <div class="container footer-grid">
      <!-- Col 1: Company Profile with New Official Logo -->
      <div class="footer-col col-brand">
        <div class="footer-logo-wrap">
          <img 
            src={siteConfig.logo.full} 
            alt="Abyssinian Tour Operator" 
            width="280" 
            height="65" 
            class="footer-logo" 
          />
        </div>
        <p class="footer-bio">
          Abyssinian Tour Operator is an officially accredited, native-owned Ethiopian Destination Management Company (DMC) headquartered in Addis Ababa. For over two decades, we have operated direct, high-end private expeditions and turnkey white-label B2B ground handling across Ethiopia's 20 flagship destinations.
        </p>
        <div class="footer-badges">
          <span class="trust-pill">20+ Years Field Leadership</span>
          <span class="trust-pill">Direct DMC Tariffs</span>
        </div>
      </div>

      <!-- Col 2: The 5 Expedition Pillars -->
      <div class="footer-col">
        <h4 class="footer-heading">EXPEDITION PILLARS</h4>
        <ul class="footer-links">
          {tourPillars.map(pillar => (
            <li>
              <a href={`/tours?pillar=${pillar.id}`}>
                {pillar.name}
              </a>
            </li>
          ))}
          <li><a href="/destinations">All 15 Ethiopia Destinations</a></li>
        </ul>
      </div>

      <!-- Col 3: Navigation & Client Links -->
      <div class="footer-col">
        <h4 class="footer-heading">NAVIGATION & CLIENT DESK</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/tours">All 20 Master Itineraries</a></li>
          <li><a href="/destinations">Destinations Guide</a></li>
          <li><a href="/about-us">About Us & Founder Profile</a></li>
          <li><a href="/testimonials">Client Testimonials & Partner Reviews</a></li>
          <li><a href="/b2b">B2B Agent Portal & NET Tariffs</a></li>
          <li><a href="/travel-guide">Pre-Trip Travel & Packing Guide</a></li>
          <li><a href="/contact-us">Contact & Booking Inquiry</a></li>
          <li><a href="/image-attributions">Image & Photographic Attributions</a></li>
        </ul>
      </div>

      <!-- Col 4: Direct Field Contact Details -->
      <div class="footer-col col-contact">
        <h4 class="footer-heading">FIELD DISPATCH & HEADQUARTERS</h4>
        <div class="contact-details">
          <p class="contact-line">
            <span class="contact-label">Managing Director:</span>
            <span class="contact-val">Dessiew Abunie Dejenie</span>
          </p>
          <p class="contact-line">
            <span class="contact-label">Head Office:</span>
            <span class="contact-val">{siteConfig.contact.address.full}</span>
          </p>
          <p class="contact-line">
            <span class="contact-label">24/7 Field Support / WhatsApp:</span>
            <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-val highlight-gold">
              {siteConfig.contact.phoneDisplay}
            </a>
          </p>
          <p class="contact-line">
            <span class="contact-label">Office Phone:</span>
            <span class="contact-val">{siteConfig.contact.officePhoneDisplay}</span>
          </p>
          <p class="contact-line">
            <span class="contact-label">General Desk:</span>
            <a href={`mailto:${siteConfig.contact.emails.general}`} class="contact-val">
              {siteConfig.contact.emails.general}
            </a>
          </p>
          <p class="contact-line">
            <span class="contact-label">B2B Agent Desk:</span>
            <a href={`mailto:${siteConfig.contact.emails.b2b}`} class="contact-val">
              {siteConfig.contact.emails.b2b}
            </a>
          </p>
          <p class="contact-line">
            <span class="contact-label">Official Website:</span>
            <span class="contact-val">www.abyssiniatouroperator.com</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <div class="footer-legal-col">
        <p class="copyright">
          &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved. Licensed Inbound DMC — Ethiopian Ministry of Tourism.
        </p>
        <p class="developer-credit">
          Website developed by <a href="https://linktr.ee/seyfadinA" target="_blank" rel="noopener noreferrer" class="dev-link">Seyfadin.A</a>
        </p>
      </div>
      <div class="footer-bottom-links">
        <a href="/contact-us">Privacy & Terms</a>
        <span class="sep">&bull;</span>
        <a href="/b2b">Wholesale Tariffs</a>
        <span class="sep">&bull;</span>
        <a href="/image-attributions">Photo Attributions</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #120F0D;
    color: #D1C5B6;
    font-size: 0.9rem;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    margin-top: auto;
    width: 100%;
    max-width: 100%;
  }

  .footer-accreditation {
    background-color: #1A1512;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem 0;
  }

  .footer-accreditation-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .accred-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #F0E6D8;
    letter-spacing: 0.3px;
  }

  .footer-main {
    padding: 4rem 0 3rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1.1fr 1.1fr 1.5fr;
    gap: 2.5rem;
  }

  .footer-logo-wrap {
    background-color: #FFFFFF;
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    margin-bottom: 1.25rem;
  }

  .footer-logo {
    height: 48px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .footer-bio {
    color: #AFA292;
    font-size: 0.88rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .footer-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .trust-pill {
    background-color: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #E5C158;
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #E5C158;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: #BDB0A0;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #D4AF37;
    transform: translateX(3px);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.85rem;
  }

  .contact-line {
    line-height: 1.45;
  }

  .contact-label {
    display: block;
    color: #8C8072;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 0.15rem;
  }

  .contact-val {
    color: #E2D7C8;
  }

  .highlight-gold {
    color: #D4AF37 !important;
    font-weight: 600;
  }

  .footer-bottom {
    background-color: #0A0807;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.8rem;
    color: #8A7E70;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-legal-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .developer-credit {
    font-size: 0.76rem;
    color: #9C8F80;
    letter-spacing: 0.2px;
  }

  .dev-link {
    color: #D4AF37;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .dev-link:hover {
    color: #FFFFFF;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-bottom-links a:hover {
    color: #D4AF37;
  }

  .sep {
    opacity: 0.4;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-accreditation-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
