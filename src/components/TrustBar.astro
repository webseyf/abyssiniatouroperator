---
interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = "Direct DMC Value Proposition",
  subheadline = "Partner with a licensed inbound DMC offering 100% white-label execution, direct Toyota 4x4 fleet ownership, and guaranteed 12-hour proposal turnarounds."
} = Astro.props;
---

<section class="trust-section">
  <div class="container">
    <div class="trust-intro">
      <span class="trust-badge">DIRECT OPERATOR ADVANTAGE</span>
      <h2 class="trust-headline">{headline}</h2>
      <p class="trust-subheadline">{subheadline}</p>
    </div>

    <div class="trust-grid">
      <!-- 1. Direct Ownership -->
      <div class="trust-card">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
        </div>
        <div class="trust-content">
          <h4>Direct DMC Ownership</h4>
          <p>We own and manage our ground operations—eliminating third-party brokers and pass-through markups.</p>
        </div>
      </div>

      <!-- 2. Fleet & Equipment -->
      <div class="trust-card">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        </div>
        <div class="trust-content">
          <h4>Private 4x4 Fleet</h4>
          <p>Heavy-duty Toyota Land Cruiser 76/79 Series & Prados with dual A/C, satellite tracking, and coolers.</p>
        </div>
      </div>

      <!-- 3. Native Guides -->
      <div class="trust-card">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </div>
        <div class="trust-content">
          <h4>100% Native Guides</h4>
          <p>Certified historians, botanists, and ethnographers with direct connections to community elders.</p>
        </div>
      </div>

      <!-- 4. Turnaround & Security -->
      <div class="trust-card">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="trust-content">
          <h4>12-Hour Proposal Desk</h4>
          <p>Guaranteed 12-hour turnaround on custom itineraries, NET pricing, and priority domestic flight ticketing.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    background: linear-gradient(180deg, #A27221 0%, #7D5413 100%);
    color: #FFFFFF;
    padding: 3rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
  }

  .trust-intro {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 2.5rem auto;
  }

  .trust-badge {
    display: inline-block;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #FFE699;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .trust-headline {
    color: #FFFFFF;
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    margin-bottom: 0.5rem;
  }

  .trust-subheadline {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .trust-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: background var(--transition-fast);
  }

  .trust-card:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .trust-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #FFE699;
  }

  .trust-content h4 {
    color: #FFFFFF;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .trust-content p {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  @media (max-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

