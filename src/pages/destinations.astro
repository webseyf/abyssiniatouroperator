---
import MainLayout from '../layouts/MainLayout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import TrustBar from '../components/TrustBar.astro';
import { destinationsList } from '../data/destinations';
import { siteConfig } from '../config/site';

const categories = Array.from(new Set(destinationsList.map(d => d.category)));
---

<MainLayout 
  title="Ethiopia Destinations Guide | Abyssinian Tour Operator"
  description="Explore Ethiopia's most revered UNESCO World Heritage sanctuaries, high escarpments, lava lakes, and tribal valleys with native ground experts."
  image="/images/home/hero-destinations-gheralta.jpg"
>
  <!-- Page Hero -->
  <section class="page-hero" style="background-image: url('/images/home/hero-destinations-gheralta.jpg');">
    <div class="container">
      <span class="section-label light">ETHIOPIA DESTINATION DIRECTORY</span>
      <h1>ETHIOPIA DESTINATIONS & REGIONS</h1>
      <p class="subtitle">
        From the 12th-century rock-hewn monoliths of Lalibela and boiling lava calderas of the Danakil to the ancestral communities of the South Omo Valley and the wild Arabica rainforests of Kaffa.
      </p>
    </div>
  </section>

  <!-- Filter & Search Toolbar -->
  <section class="dest-toolbar">
    <div class="container toolbar-inner">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input 
          type="text" 
          id="destSearchInput" 
          placeholder="Filter destinations by name or attraction (e.g. Lalibela, Omo, Wolf)..." 
          aria-label="Filter destinations"
        />
      </div>

      <div class="dest-filter-pills">
        <button type="button" class="dest-pill active" data-cat="all">All Destinations ({destinationsList.length})</button>
        <button type="button" class="dest-pill" data-cat="historical">Historical Monoliths</button>
        <button type="button" class="dest-pill" data-cat="extreme">Volcanoes & Deserts</button>
        <button type="button" class="dest-pill" data-cat="cultural">Indigenous Omo Valley</button>
        <button type="button" class="dest-pill" data-cat="wildlife">Wildlife & Treks</button>
      </div>
    </div>
  </section>

  <!-- Destinations Grid -->
  <section class="section-pad">
    <div class="container">
      <div class="dest-count-bar">
        <span id="destCount">Showing all <strong>{destinationsList.length}</strong> Ethiopian destinations</span>
        <span class="dest-guarantee">Covered by Abyssinian Direct Ground Fleet</span>
      </div>

      <div class="destinations-grid" id="destGrid">
        {destinationsList.map(dest => (
          <DestinationCard destination={dest} />
        ))}
      </div>

      <div id="noDestResults" class="no-dest-results" style="display: none;">
        <h3>No matching destination found</h3>
        <p>Please check your spelling or search for another Ethiopian region.</p>
        <button type="button" class="btn btn-gold btn-sm" id="resetDestFilters">Show All Destinations</button>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar />

  <!-- Direct Consultation CTA -->
  <section class="section-pad cta-dest-section">
    <div class="container text-center">
      <span class="section-label light">CUSTOM GROUND LOGISTICS</span>
      <h2 style="color: #FFFFFF;">Looking for a Multi-Destination Combined Route?</h2>
      <p style="max-width: 720px; margin: 0.85rem auto 1.85rem auto; color: #E2D7C8;">
        Our founder Dessiew Abunie Dejenie designs custom, cross-country expeditions connecting flights, 4x4 convoys, and private mobile camping seamlessly.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <button type="button" class="btn btn-green btn-lg js-open-quote-modal" data-tour="Multi-Destination Combined Circuit">
          REQUEST MULTI-DESTINATION QUOTE
        </button>
        <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg">
          WHATSAPP DISPATCH: {siteConfig.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .dest-toolbar {
    background-color: #241D17;
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    padding: 1.25rem 0;
  }

  .toolbar-inner {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background-color: #1A1512;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.85rem;
    color: #FFFFFF;
    flex: 1;
    max-width: 440px;
  }

  .search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 0.88rem;
    width: 100%;
  }

  .dest-filter-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .dest-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #E2D7C8;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .dest-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
  }

  .dest-pill.active {
    background: var(--color-gold);
    color: #FFFFFF;
    border-color: var(--color-gold);
  }

  .dest-count-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-sand-border);
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .dest-guarantee {
    color: var(--color-gold-deep);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .no-dest-results {
    text-align: center;
    padding: 4rem 1rem;
    background-color: var(--color-sand-card);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-sand-border);
  }

  .cta-dest-section {
    background: linear-gradient(135deg, #1C1814 0%, #2A2118 100%);
    color: #FFFFFF;
  }

  .text-center {
    text-align: center;
  }

  @media (max-width: 1024px) {
    .destinations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .destinations-grid {
      grid-template-columns: 1fr;
    }
    .dest-count-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('destSearchInput') as HTMLInputElement;
  const pills = document.querySelectorAll('.dest-pill');
  const cards = document.querySelectorAll('.destination-card');
  const countEl = document.getElementById('destCount');
  const noRes = document.getElementById('noDestResults');
  const resetBtn = document.getElementById('resetDestFilters');

  let activeCat = 'all';
  let searchTerm = '';

  function filterDestinations() {
    let count = 0;
    cards.forEach(card => {
      const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
      const cardName = (card.getAttribute('data-name') || '').toLowerCase();
      const cardText = (card.textContent || '').toLowerCase();

      let matchesCat = true;
      if (activeCat === 'historical') {
        matchesCat = cardCategory.includes('historic') || cardCategory.includes('monolith') || cardCategory.includes('empire') || cardCategory.includes('castle');
      } else if (activeCat === 'extreme') {
        matchesCat = cardCategory.includes('desert') || cardCategory.includes('volcan');
      } else if (activeCat === 'cultural') {
        matchesCat = cardCategory.includes('ethno') || cardCategory.includes('cultural') || cardCategory.includes('omo');
      } else if (activeCat === 'wildlife') {
        matchesCat = cardCategory.includes('wildlife') || cardCategory.includes('trek') || cardCategory.includes('bird');
      }

      const matchesSearch = !searchTerm || cardName.includes(searchTerm) || cardText.includes(searchTerm);

      if (matchesCat && matchesSearch) {
        (card as HTMLElement).style.display = 'flex';
        count++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (countEl) {
      countEl.innerHTML = `Showing <strong>${count}</strong> Ethiopian destinations`;
    }

    if (noRes) {
      noRes.style.display = count === 0 ? 'block' : 'none';
    }
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCat = pill.getAttribute('data-cat') || 'all';
      filterDestinations();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterDestinations();
  });

  resetBtn?.addEventListener('click', () => {
    activeCat = 'all';
    searchTerm = '';
    if (searchInput) searchInput.value = '';
    pills.forEach(p => p.classList.toggle('active', p.getAttribute('data-cat') === 'all'));
    filterDestinations();
  });
</script>

