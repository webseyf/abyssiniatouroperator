---
import MainLayout from '../layouts/MainLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../config/site';

const guideSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Ethiopia Pre-Trip Travel & Packing Guide",
  "description": "Comprehensive pre-trip field guidance compiled by native ground experts: visas, health, packing lists, cultural etiquette, drone regulations, and emergency field dispatch.",
  "image": "https://abyssiniatouroperator.com/images/destinations/gondar-castles.jpg",
  "publisher": {
    "@type": "TravelAgency",
    "name": siteConfig.companyName,
    "url": "https://abyssiniatouroperator.com",
    "telephone": siteConfig.contact.phone
  }
};
---

<MainLayout 
  title="Pre-Trip Travel & Packing Guide for Ethiopia | Abyssinian Tour Operator"
  description="Essential field guidance compiled by native ground experts: visas (e-Visa), health, regional packing lists, cultural etiquette, drone laws, and emergency field dispatch."
  image="/images/destinations/gondar-castles.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(guideSchema)} />

  <!-- Top DMC Advisory Bar (Matching Client Wireframe) -->
  <section class="guide-top-bar">
    <div class="container guide-top-bar-inner">
      <div class="guide-top-bar-text">
        <span class="guide-top-badge">NATIVE GROUND HANDLER</span>
        <p>Abyssinian Tour Operator is the original local DMC and ground operator, providing expert local handling for private and B2B clients in Ethiopia.</p>
      </div>
      <div class="guide-top-bar-cta">
        <a href="/contact-us" class="btn btn-gold btn-sm">[ Request Quote ]</a>
      </div>
    </div>
  </section>

  <!-- Hero Banner with Gondar Castles (Matching Wireframe) -->
  <section class="guide-hero-banner" style="background-image: linear-gradient(rgba(18, 16, 14, 0.45), rgba(18, 16, 14, 0.55)), url('/images/destinations/gondar-castles.jpg');">
    <div class="container text-center">
      <h1 class="guide-hero-title">PRE-TRIP TRAVEL &amp; PACKING GUIDE</h1>
    </div>
  </section>

  <!-- Main Editorial Layout -->
  <section class="section-pad guide-content-section">
    <div class="container">
      <div class="guide-layout">
        
        <!-- ============================================================== -->
        <!-- LEFT COLUMN: SECTIONS 1, 2, 3, 4                              -->
        <!-- ============================================================== -->
        <div class="guide-left-col">
          
          <!-- 1. PRE-TRIP CHECKLIST -->
          <div class="guide-panel">
            <h2 class="guide-sec-title">1. PRE-TRIP CHECKLIST</h2>
            <div class="checklist-grid-2x2">
              
              <!-- Visa & Documents -->
              <div class="check-box">
                <div class="check-box-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </div>
                <div class="check-box-content">
                  <h3>Visa &amp; Documents</h3>
                  <p>Check validity, secure e-visa, digital &amp; printed copies.</p>
                </div>
              </div>

              <!-- Health -->
              <div class="check-box">
                <div class="check-box-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v20M2 12h20"></path>
                    <rect x="5" y="5" width="14" height="14" rx="2" stroke-width="1.5"></rect>
                  </svg>
                </div>
                <div class="check-box-content">
                  <h3>Health</h3>
                  <p>Vaccinations, Malaria prophylaxis, personal prescriptions.</p>
                </div>
              </div>

              <!-- Travel Insurance -->
              <div class="check-box">
                <div class="check-box-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                </div>
                <div class="check-box-content">
                  <h3>Travel Insurance</h3>
                  <p>Comprehensive cover with emergency repatriation.</p>
                </div>
              </div>

              <!-- Flights & Itinerary -->
              <div class="check-box">
                <div class="check-box-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"></path>
                  </svg>
                </div>
                <div class="check-box-content">
                  <h3>Flights &amp; Itinerary</h3>
                  <p>E-tickets, domestic flight confirmations, final itinerary.</p>
                </div>
              </div>

            </div>
          </div>

          <!-- 2. ESSENTIAL PACKING LIST & PREPARATION -->
          <div class="guide-panel">
            <h2 class="guide-sec-title">2. ESSENTIAL PACKING LIST &amp; PREPARATION</h2>
            <div class="packing-items-flow">
              
              <!-- Clothing -->
              <div class="pack-item-row">
                <div class="pack-item-visual">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3h12l2 6-4 1-1-4H9L8 6 4 9 6 3z"></path>
                    <path d="M6 3v18l6-2 6 2V3"></path>
                  </svg>
                </div>
                <div class="pack-item-desc">
                  <h3>Clothing (Warm &amp; Dust Protection)</h3>
                  <p>
                    Lightweight cotton/linen long pants; short-sleeve shirts (neutral tones). 
                    Durable walking shoes; sports sandals. Lightweight rain shell.
                  </p>
                </div>
              </div>

              <!-- Medical & Hygiene -->
              <div class="pack-item-row">
                <div class="pack-item-visual">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 2h4M9 2v4a3 3 0 0 0 3 3h0a3 3 0 0 0 3-3V2"></path>
                    <rect x="7" y="9" width="10" height="13" rx="2"></rect>
                    <line x1="12" y1="13" x2="12" y2="17"></line>
                    <line x1="10" y1="15" x2="14" y2="15"></line>
                  </svg>
                </div>
                <div class="pack-item-desc">
                  <h3>Medical &amp; Hygiene</h3>
                  <p>
                    Sunscreen (high SPF); lip balm; hydration salts. Antihistamines; pain relief; first-aid.
                  </p>
                </div>
              </div>

              <!-- Electronics & Photography -->
              <div class="pack-item-row">
                <div class="pack-item-visual">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                    <path d="M12 6v6"></path>
                    <path d="M10 9h4"></path>
                    <circle cx="12" cy="17" r="1.5"></circle>
                  </svg>
                </div>
                <div class="pack-item-desc">
                  <h3>Electronics &amp; Photography</h3>
                  <p>
                    Multi-port high-capacity power bank. Memory cards; spare batteries. 
                    <span class="confiscate-note">(Unsanctioned drones will be confiscated)</span>
                  </p>
                </div>
              </div>

              <!-- Dry bags & Flashlights -->
              <div class="pack-item-row">
                <div class="pack-item-visual">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6l-6-4-6 4v10a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4V6z"></path>
                    <path d="M9 10h6"></path>
                  </svg>
                </div>
                <div class="pack-item-desc">
                  <h3>Dust-proof dry bags &amp; Illumination</h3>
                  <p>
                    Dust-proof dry bags (for sensitive gear). Headlamps or small flashlights.
                  </p>
                </div>
              </div>

            </div>
          </div>

          <!-- 3. GUIDELINES & ETIQUETTE (Summary Box) -->
          <div class="guide-panel guide-summary-card">
            <h2 class="guide-sec-title">3. GUIDELINES &amp; ETIQUETTE</h2>
            <div class="guidelines-card-list">
              
              <!-- Photography & Ethics -->
              <div class="guide-rule-item">
                <div class="guide-rule-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <circle cx="5" cy="5" r="2"></circle>
                    <circle cx="19" cy="5" r="2"></circle>
                    <circle cx="5" cy="19" r="2"></circle>
                    <circle cx="19" cy="19" r="2"></circle>
                    <line x1="7" y1="7" x2="10" y2="10"></line>
                    <line x1="17" y1="7" x2="14" y2="10"></line>
                    <line x1="7" y1="17" x2="10" y2="14"></line>
                    <line x1="17" y1="17" x2="14" y2="14"></line>
                  </svg>
                </div>
                <div class="guide-rule-body">
                  <h4>PHOTOGRAPHY &amp; ETHICS</h4>
                  <p>
                    <strong>Drone Usage:</strong> Strict regulations; prior CAA authority required. 
                    <strong>Omo Valley Portraits:</strong> Always coordinate with guide; fees are respectfully negotiated upfront. 
                    <strong>Cultural Sensitivity:</strong> Ask permission; no military/government/police photography.
                  </p>
                </div>
              </div>

              <!-- Cultural Etiquette -->
              <div class="guide-rule-item">
                <div class="guide-rule-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v4M10 4h4"></path>
                    <path d="M12 6L4 12v9h16v-9L12 6z"></path>
                    <path d="M10 21v-5a2 2 0 0 1 4 0v5"></path>
                  </svg>
                </div>
                <div class="guide-rule-body">
                  <h4>CULTURAL ETIQUETTE</h4>
                  <p>
                    <strong>Church Rules:</strong> Shoes off; right foot first. Cover shoulders/knees; headscarves for women. 
                    <strong>Greeting &amp; Respect:</strong> Right-hand custom; use right hand for giving/receiving. Gentle nod or right handshake.
                  </p>
                </div>
              </div>

              <!-- Tipping Guidance -->
              <div class="guide-rule-item">
                <div class="guide-rule-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                    <circle cx="12" cy="12" r="2"></circle>
                    <path d="M6 12h.01M18 12h.01"></path>
                  </svg>
                </div>
                <div class="guide-rule-body">
                  <h4>TIPPING GUIDANCE</h4>
                  <p>
                    <strong>Tipping (Discretionary Benchmark):</strong> Lead Tour Guide: $15 - $25 USD/group/day. Professional 4x4 Driver: $10 - $15 USD/group/day.
                  </p>
                </div>
              </div>

            </div>
          </div>

          <!-- 4. FLIGHT & VEHICLE INFORMATION -->
          <div class="guide-panel">
            <h2 class="guide-sec-title">4. FLIGHT &amp; VEHICLE INFORMATION</h2>
            <div class="fleet-info-container">
              
              <!-- Photo A: Domestic Flights -->
              <div class="fleet-subcard">
                <div class="fleet-subcard-img">
                  <img src="/images/guide/ethiopian-airlines-flight.jpg" alt="Photo A. Ethiopian Airlines Regional Flight" width="240" height="150" loading="lazy" />
                </div>
                <div class="fleet-subcard-info">
                  <h4>Photo A. Domestic Flight Experience (e.g., Ethiopian Airlines regional plane)</h4>
                  <p>
                    Standardized description of domestic flights and baggage limits. Standard flights only are transmitted included, baggage limits and schedules are coordinated with domestic booking desks. (20 kg checked + 7 kg carry-on).
                  </p>
                </div>
              </div>

              <!-- Photo B: Private 4x4 Fleet -->
              <div class="fleet-subcard">
                <div class="fleet-subcard-img">
                  <img src="/images/fleet/abyssinian-highland-4x4-convoy.jpg" alt="Photo B. Private 4x4 Transport Fleet" width="240" height="150" loading="lazy" />
                </div>
                <div class="fleet-subcard-info">
                  <h4>Photo B. Private 4x4 Transport Fleet</h4>
                  <div class="fleet-feature-pills">
                    <span class="pill-tag"><span class="pill-icon">❄️</span> A/C Climate Controlled</span>
                    <span class="pill-tag"><span class="pill-icon">💺</span> Seatbelts for all passengers</span>
                    <span class="pill-tag"><span class="pill-icon">📡</span> Satellite Phone</span>
                    <span class="pill-tag"><span class="pill-icon">🩹</span> First-Aid Equipment</span>
                    <span class="pill-tag"><span class="pill-icon">💧</span> Mineral Water Supplied</span>
                  </div>
                </div>
              </div>

            </div>

            <!-- Download Button -->
            <div class="guide-download-cta text-center">
              <button type="button" class="btn btn-gold btn-lg" onclick="window.print();">
                [ Review and Download Your Custom Guide ]
              </button>
            </div>
          </div>

        </div>

        <!-- ============================================================== -->
        <!-- RIGHT COLUMN: SECTIONS 5, 6, 7 & OFFICIAL FOOTER STAMP         -->
        <!-- ============================================================== -->
        <aside class="guide-right-col">
          
          <!-- 5. PHOTOGRAPHY GUIDELINES & ETHICAL ETIQUETTE -->
          <div class="side-panel">
            <div class="side-panel-header">
              <span class="badge-num">5</span>
              <h3>PHOTOGRAPHY GUIDELINES &amp; ETHICAL ETIQUETTE</h3>
            </div>
            
            <p class="side-intro-lead">
              Abyssinian Tour Operator is the original local DMC and ground operator, providing expert local handling for private and B2B clients in Ethiopia.
            </p>

            <ul class="side-detail-list">
              <li>
                <strong>Drone Usage:</strong> Strict regulations; prior CAA authority required. Drones without official permit will be confiscated at Bole Airport customs.
              </li>
              <li>
                <strong>Omo Valley Portraits:</strong> Always coordinate with guide; fees are respectfully negotiated upfront.
              </li>
              <li>
                <strong>Cultural Sensitivity:</strong> Ask permission; no military/government/police photography.
              </li>
              <li>
                <strong>Equipment Care:</strong> Fine volcanic dust in Danakil and red laterite soil in South Omo can penetrate optics; bring dust-proof dry bags and lens blowers.
              </li>
            </ul>
          </div>

          <!-- 6. CULTURAL ETIQUETTE & TIPPING GUIDANCE -->
          <div class="side-panel">
            <div class="side-panel-header">
              <span class="badge-num">6</span>
              <h3>CULTURAL ETIQUETTE &amp; TIPPING GUIDANCE</h3>
            </div>

            <div class="side-etiquette-content">
              <div class="eti-sub-block">
                <strong>Church Entry:</strong> Shoes off; right foot first. Cover shoulders/knees; headscarves for women.
              </div>
              <div class="eti-sub-block">
                <strong>Church Rules:</strong> Shoes off; right foot first. Cover shoulders/knees; headscarves for women. Maintain a respectful tone inside rock-hewn sanctuaries.
              </div>
              <div class="eti-sub-block">
                <strong>Greeting &amp; Respect:</strong> Right-hand custom; use right hand for giving/receiving. Gentle nod or right handshake.
              </div>

              <div class="tipping-benchmarks-box">
                <h4>Tipping (Discretionary Benchmark):</h4>
                <ul>
                  <li><strong>Lead Tour Guide:</strong> $15 &ndash; $25 USD/group/day</li>
                  <li><strong>Professional 4x4 Driver:</strong> $10 &ndash; $15 USD/group/day</li>
                  <li><strong>Wilderness Expedition Chef / Local Park Scouts:</strong> $5 &ndash; $10 USD/day</li>
                  <li><strong>Hotel Staff &amp; Luggage Porters:</strong> 100 &ndash; 200 ETB per service.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 7. EMERGENCY CONTACTS & DIRECT FIELD DISPATCH -->
          <div class="side-panel">
            <div class="side-panel-header">
              <span class="badge-num">7</span>
              <h3>EMERGENCY CONTACTS &amp; DIRECT FIELD DISPATCH</h3>
            </div>

            <div class="side-contacts-content">
              <p><strong>Abyssinian Headquarters:</strong> Main Dispatch Desk</p>
              <p><strong>CEO &amp; Lead Logistician:</strong> {siteConfig.founder.name}</p>
              <p><strong>Direct Mobile / WhatsApp:</strong> <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="link-gold">{siteConfig.contact.phoneDisplay}</a></p>
              <p><strong>24/7 Operations Email:</strong> <a href={`mailto:${siteConfig.contact.emails.b2b}`}>{siteConfig.contact.emails.b2b}</a></p>
              <p><strong>Official Website:</strong> www.abyssiniatouroperator.com</p>

              <div style="margin-top: 1rem;">
                <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-green btn-sm" style="width: 100%; text-align: center; display: block;">
                  WhatsApp Field Support
                </a>
              </div>
            </div>
          </div>

          <!-- Bottom Official Accreditation Card (Black Card in Wireframe) -->
          <div class="official-signature-card">
            <div class="sig-logo">
              <span class="sig-emblem">&#9650;</span>
              <span class="sig-name">ABYSSINIAN</span>
              <span class="sig-sub">TOUR OPERATOR</span>
            </div>
            <div class="sig-divider"></div>
            <p class="sig-details">
              <strong>Abyssinian Tour Operator</strong> | CEO: Dessiew Abunie Dejenie | Head Office: Addis Ababa, Ethiopia | 24/7 Support: +251 920 009 100 | Office: +251 11 6 123 456 | general email: <a href="mailto:info@abyssiniatouroperator.com">info@abyssiniatouroperator.com</a> | b2b email: <a href="mailto:b2b@abyssiniatouroperator.com">b2b@abyssiniatouroperator.com</a> | <a href="https://abyssiniatouroperator.com">www.abyssiniatouroperator.com</a>
            </p>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar />
</MainLayout>

<style>
  /* Top DMC Advisory Bar */
  .guide-top-bar {
    background-color: #211c18;
    color: #e5dfd3;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .guide-top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .guide-top-bar-text {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .guide-top-bar-text p {
    margin: 0;
    color: #dfd7ca;
  }

  .guide-top-badge {
    display: inline-block;
    background-color: var(--color-gold);
    color: #1a1612;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.55rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  /* Hero Banner */
  .guide-hero-banner {
    padding: 4.5rem 0;
    background-size: cover;
    background-position: center;
    position: relative;
    border-bottom: 2px solid var(--color-gold);
  }

  .guide-hero-title {
    color: #FFFFFF;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  /* Main Editorial Layout (2-Column Grid) */
  .guide-layout {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: 2.25rem;
    align-items: start;
  }

  .guide-left-col {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  /* Guide Panels */
  .guide-panel {
    background-color: #FFFFFF;
    border: 1px solid var(--color-sand-border);
    border-radius: var(--radius-sm);
    padding: 1.75rem;
  }

  .guide-sec-title {
    font-family: var(--font-sans);
    font-size: 1.22rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--color-gold);
  }

  /* 1. Checklist 2x2 Grid */
  .checklist-grid-2x2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .check-box {
    background-color: #FAF8F5;
    border: 1px solid #EAE3D6;
    border-radius: var(--radius-sm);
    padding: 1.15rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .check-box-icon {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    background-color: #EDE7DC;
    color: var(--color-gold-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .check-box-content h3 {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 700;
    margin: 0 0 0.35rem 0;
    color: var(--color-primary-dark);
  }

  .check-box-content p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0;
  }

  /* 2. Packing Items Flow */
  .packing-items-flow {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .pack-item-row {
    display: flex;
    gap: 1.25rem;
    padding: 1.15rem;
    background-color: #FAF8F5;
    border: 1px solid #EAE3D6;
    border-radius: var(--radius-sm);
    align-items: center;
  }

  .pack-item-visual {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    background-color: #E8E0D2;
    color: var(--color-primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pack-item-desc h3 {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 700;
    margin: 0 0 0.35rem 0;
    color: var(--color-primary-dark);
  }

  .pack-item-desc p {
    font-size: 0.84rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .confiscate-note {
    display: block;
    color: #c94a29;
