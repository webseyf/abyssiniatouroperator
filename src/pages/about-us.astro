---
import MainLayout from '../layouts/MainLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../config/site';
---

<MainLayout 
  title="About Us | Abyssinian Tour Operator — Direct Inbound DMC Ethiopia"
  description="Learn about Abyssinian Tour Operator, our founder Dessiew Abunie Dejenie, our direct Toyota 4x4 fleet ownership, and our 20+ years of native ground leadership across Ethiopia."
  image="/images/destinations/gondar-castles.jpg"
>
  <!-- Page Hero (Matching Design Reference Screenshot 5) -->
  <section class="page-hero" style="background-image: url('/images/destinations/gondar-castles.jpg');">
    <div class="container">
      <span class="section-label light">COMPANY PROFILE & LEADERSHIP</span>
      <h1>ABOUT ABYSSINIAN TOUR OPERATOR</h1>
      <p class="subtitle">
        Direct field leadership | 100% Native Ground Ownership | Ministry of Tourism Accredited DMC
      </p>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar 
    headline="Direct Ground DMC Execution Across Ethiopia" 
    subheadline="Headquartered in Addis Ababa, we operate uncompromised private expeditions and wholesale B2B ground handling with our own heavy-duty 4x4 fleet."
  />

  <section class="section-pad">
    <div class="container">
      <div class="editorial-grid">
        <!-- Main Column -->
        <div class="about-main-col">
          <!-- Company Overview -->
          <div class="card-sand content-section">
            <span class="section-label">ESTABLISHED GROUND DMC</span>
            <h2>Company Overview</h2>
            <div class="prose">
              <p>
                Founded and headquartered in Addis Ababa, <strong>Abyssinian Tour Operator</strong> is an officially accredited, direct inbound Destination Management Company (DMC) in Ethiopia. For over 20 years, we have specialized in delivering high-end, private B2C expeditions and turnkey B2B ground handling for international travel partners across the Horn of Africa.
              </p>
              <p>
                We operate our own fleet of heavy-duty Toyota 4x4 Land Cruisers, maintain preferred contracts with premier eco-lodges, and deploy private wilderness catering teams for extreme terrain. By eliminating middleman markups, we deliver uncompromised field safety, authentic local immersions, and direct wholesale tariffs across Ethiopia’s 20 flagship destinations.
              </p>
            </div>
          </div>

          <!-- Founder & Managing Director Profile -->
          <div class="card-white content-section">
            <span class="section-label">FIELD LEADERSHIP</span>
            <h2>Founder & Managing Director Profile</h2>

            <div class="founder-box">
              <div class="founder-img-col">
                <img 
                  src="/images/about/dessiew-field-expedition.jpg" 
                  alt={siteConfig.founder.name} 
                  class="founder-portrait"
                  width="180" 
                  height="180" 
                  style="object-position: top center;"
                />
                <span class="founder-badge">Founder & CEO</span>
              </div>
              <div class="founder-info-col">
                <h3>{siteConfig.founder.name}</h3>
                <p class="founder-subtitle">Founder & Lead Expedition Logistician</p>
                <blockquote class="founder-quote-inline">
                  "{siteConfig.founder.quote}"
                </blockquote>
              </div>
            </div>

            <div class="prose">
              <p>
                With over two decades of hands-on field leadership, Dessiew Abunie Dejenie built Abyssinian Tour Operator on the principle of direct, native execution. Starting his career in the field, Dessiew has personally led hundreds of expeditions across the rugged Simien escarpment, the active lava fields of the Danakil Depression, and the remote communities of the South Omo Valley.
              </p>
              <p>
                His deep-rooted relationships with local village elders, national park wardens, and heritage site guardians ensure that every Abyssinian itinerary operates with privileged access, strict safety protocols, and ethical community engagement. Today, Dessiew oversees all ground operations from our Addis Ababa headquarters, ensuring every guest and international agent receives 24/7 personal oversight.
              </p>
            </div>
          </div>

          <!-- Our Core Operational Guarantees -->
          <div class="card-sand content-section">
            <span class="section-label">OPERATING STANDARDS</span>
            <h2>Our Core Operational Guarantees</h2>
            <div class="guarantees-grid">
              <div class="guarantee-box">
                <div class="guarantee-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <h4>Direct Local Ownership</h4>
                <p>We own and manage our ground operations—no outsourcing to third-party brokers or subcontracted layers.</p>
              </div>

              <div class="guarantee-box">
                <div class="guarantee-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path></svg>
                </div>
                <h4>100% Native Multi-Lingual Guides</h4>
                <p>Certified local experts with deep historical, ethnographic, and biological knowledge fluent in English, French, German, and Spanish.</p>
              </div>

              <div class="guarantee-box">
                <div class="guarantee-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                </div>
                <h4>Rigorous Field Security & Comfort</h4>
                <p>Heavy-duty 4x4 Land Cruisers equipped with comprehensive first-aid kits, satellite tracking, dual spare tires, and seasoned drivers.</p>
              </div>

              <div class="guarantee-box">
                <div class="guarantee-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </div>
                <h4>Ethical & Sustainable Tourism</h4>
                <p>We work directly with indigenous communities in the Omo Valley and national parks to ensure fair wages and sustainable cultural preservation.</p>
              </div>
            </div>
          </div>

          <!-- Ground Infrastructure & Fleet Specifications -->
          <div class="card-white content-section">
            <span class="section-label">LOGISTICAL ASSETS</span>
            <h2>Ground Infrastructure & Fleet Specifications</h2>
            
            <div class="fleet-showcase">
              <div class="fleet-img-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                <div class="fleet-img-item" style="border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--color-sand-border);">
                  <img 
                    src="/images/fleet/abyssinian-danakil-4x4-expedition.jpg" 
                    alt="Abyssinian Tour Operator Private 4x4 Fleet - Danakil Depression Expedition Spec" 
                    style="width: 100%; height: 240px; object-fit: cover;" 
                  />
                  <div style="background: #231C16; color: #E5C158; padding: 0.5rem 0.75rem; font-size: 0.78rem; font-weight: 700;">
                    Official Field Fleet: Danakil Depression Expedition Spec
                  </div>
                </div>
                <div class="fleet-img-item" style="border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--color-sand-border);">
                  <img 
                    src="/images/fleet/abyssinian-highland-4x4-convoy.jpg" 
                    alt="Abyssinian Tour Operator Private 4x4 Fleet - Ethiopian Highland Escort Convoy" 
                    style="width: 100%; height: 240px; object-fit: cover;" 
                  />
                  <div style="background: #231C16; color: #E5C158; padding: 0.5rem 0.75rem; font-size: 0.78rem; font-weight: 700;">
                    Official Field Fleet: Cross-Country Highland Convoy
                  </div>
                </div>
              </div>

              <div class="fleet-feature-badges">
                <div class="f-feat"><span class="f-icon">&#10003;</span> Dual Climate Controlled A/C</div>
                <div class="f-feat"><span class="f-icon">&#10003;</span> 3-Point Seatbelts for All Passengers</div>
                <div class="f-feat"><span class="f-icon">&#10003;</span> Satellite Phone & GPS Tracking</div>
                <div class="f-feat"><span class="f-icon">&#10003;</span> Mineral Water Cooler Supplied</div>
                <div class="f-feat"><span class="f-icon">&#10003;</span> Field First-Aid Trauma Kits</div>
                <div class="f-feat"><span class="f-icon">&#10003;</span> Dual Spare Tires & Recovery Winches</div>
              </div>

              <div class="prose" style="margin-top: 1.5rem;">
                <h4>Field Leadership & Support Crew</h4>
                <ul>
                  <li><strong>Native Field Guides:</strong> Certified multi-lingual experts with academic backgrounds in history, anthropology, and ecology.</li>
                  <li><strong>Expedition Drivers:</strong> Veteran cross-country drivers trained in defensive driving, high-altitude mountain navigation, and desert mechanics.</li>
                  <li><strong>Wilderness Catering:</strong> Private field chefs preparing hot, freshly cooked meals with organic produce during mobile eco-camping expeditions in Danakil and Simiens.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar (Matching Screenshots Quick Facts & Gateway) -->
        <aside class="about-sidebar">
          <!-- Key Company Quick Facts (Trust Box from prompt) -->
          <div class="card-sand sidebar-card">
            <span class="section-label">OFFICIAL AUDIT</span>
            <h3 class="side-title">Key Company Quick Facts</h3>

            <div class="quick-facts-table">
              <div class="qf-row">
                <span class="qf-key">Legal License:</span>
                <span class="qf-val">Accredited Inbound DMC — Ethiopian Ministry of Tourism</span>
              </div>
              <div class="qf-row">
                <span class="qf-key">Operational Base:</span>
                <span class="qf-val">Addis Ababa, Ethiopia (24/7 Ground Ops)</span>
              </div>
              <div class="qf-row">
                <span class="qf-key">Field Fleet:</span>
                <span class="qf-val">Heavy-Duty Toyota Land Cruiser 4x4s & Coaster Buses</span>
              </div>
              <div class="qf-row">
                <span class="qf-key">Service Scope:</span>
                <span class="qf-val">20 Custom Master Itineraries Across 5 Pillars</span>
              </div>
              <div class="qf-row">
                <span class="qf-key">Proposal Turnaround:</span>
                <span class="qf-val highlight-green">Guaranteed 12-Hour Proposal & Tariff Response</span>
              </div>
              <div class="qf-row">
                <span class="qf-key">Direct Contact:</span>
                <span class="qf-val highlight-gold">{siteConfig.contact.phoneDisplay}</span>
              </div>
            </div>

            <!-- Official Ministry License Display -->
            <div class="license-sidebar-showcase" style="margin-top: 1.25rem; border-top: 1px dashed var(--color-sand-border); padding-top: 1rem; text-align: center;">
              <span class="section-label" style="font-size: 0.72rem; margin-bottom: 0.35rem;">GOVERNMENT ACCREDITATION</span>
              <h4 style="font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--color-primary-dark);">Ministry of Tourism License</h4>
              <a href="/images/about/ministry-of-tourism-license.jpg" target="_blank" rel="noopener noreferrer" title="Click to view full license certificate" style="display: block; position: relative;">
                <img 
                  src="/images/about/ministry-of-tourism-license.jpg" 
                  alt="Ethiopian Ministry of Tourism Services Competence Accreditation Certificate - Abyssinian Tour Operator" 
                  style="width: 100%; height: auto; max-height: 200px; object-fit: contain; border-radius: var(--radius-sm); border: 1px solid #D8C7B5; background: #FFF;" 
                  loading="lazy" 
                />
                <span style="display: block; font-size: 0.75rem; color: #8C6226; font-weight: 700; margin-top: 0.35rem;">&#128065; Click to View Full Official Certificate</span>
              </a>
            </div>

            <div class="side-action-btn">
              <button type="button" class="btn btn-green btn-block js-open-quote-modal" data-tour="Custom Expedition Inquiry" style="width: 100%;">
                REQUEST CUSTOM PROPOSAL
              </button>
            </div>
          </div>

          <!-- B2B Partner Portal Box (Matching Screenshot 5) -->
          <div class="card-white sidebar-card b2b-box">
            <span class="section-label">TRAVEL TRADE</span>
            <h3 class="side-title">International B2B Partner Gateway</h3>
            <p class="b2b-side-text">
              Partner with Ethiopia's leading white-label DMC. We offer unbranded vehicles, confidential wholesale NET tariffs, and priority domestic flight ticketing.
            </p>
            <a href="/b2b" class="btn btn-gold btn-block" style="width: 100%; text-align: center;">
              [ Access B2B Partner Portal ]
            </a>
          </div>

          <!-- Pre-Trip Guide Box (Matching Screenshot 5) -->
          <div class="card-sand sidebar-card">
            <span class="section-label">CLIENT GUIDANCE</span>
            <h3 class="side-title">Client Pre-Departure Advisory</h3>
            <ul class="pre-trip-side-list">
              <li><strong>Visa:</strong> E-Visa assistance prior to arrival (evisa.gov.et)</li>
              <li><strong>Currency:</strong> Crisp USD bills (2013+) and local Birr</li>
              <li><strong>Packing:</strong> Highland cold gear vs Danakil desert heat</li>
            </ul>
            <a href="/travel-guide" class="btn btn-outline-gold btn-block" style="width: 100%; text-align: center; margin-top: 1rem;">
              Read Full Travel Guide
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-main-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .content-section {
    padding: 2.25rem;
  }

  .content-section h2 {
    font-size: 1.6rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary-dark);
  }

  .prose p {
    font-size: 0.95rem;
    color: var(--color-text-main);
    line-height: 1.7;
    margin-bottom: 1.15rem;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .prose ul {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--color-text-main);
    font-size: 0.92rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* Founder Box */
  .founder-box {
    display: flex;
    gap: 2rem;
    align-items: center;
    background-color: var(--color-sand-bg);
    border: 1px solid var(--color-sand-border);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  .founder-img-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .founder-portrait {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-gold);
    box-shadow: var(--shadow-sm);
  }

  .founder-badge {
    margin-top: -12px;
    background-color: var(--color-gold);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.5px;
  }

  .founder-info-col h3 {
    font-size: 1.45rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.2rem;
  }

  .founder-subtitle {
    color: var(--color-gold-deep);
    font-weight: 700;
    font-size: 0.88rem;
    margin-bottom: 0.75rem;
  }

  .founder-quote-inline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.98rem;
    color: var(--color-primary-dark);
    border-left: 3px solid var(--color-gold);
    padding-left: 1rem;
    line-height: 1.5;
  }

  /* Guarantees Grid */
  .guarantees-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .guarantee-box {
    background-color: #FFFFFF;
    border: 1px solid var(--color-sand-border);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }

  .guarantee-icon {
    width: 40px;
    height: 40px;
    background-color: var(--color-sand-card);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold-deep);
    margin-bottom: 0.75rem;
  }

  .guarantee-box h4 {
    font-size: 0.98rem;
    font-family: var(--font-sans);
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--color-primary-dark);
  }

  .guarantee-box p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  /* Fleet Showcase */
  .fleet-showcase {
    margin-top: 1rem;
  }

  .fleet-img-wrap {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-sand-border);
    background-color: #2F2720;
  }

  .fleet-photo {
    width: 100%;
    height: 320px;
    object-fit: cover;
  }

  .fleet-img-caption {
    background-color: var(--color-sand-card);
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    border-top: 1px solid var(--color-sand-border);
  }

  .fleet-feature-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .f-feat {
    background-color: var(--color-sand-bg);
    border: 1px solid var(--color-sand-border);
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-main);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .f-icon {
    color: var(--color-green-cta);
    font-weight: 800;
  }

  /* Sidebar */
  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-card {
    padding: 1.5rem;
  }

  .side-title {
    font-size: 1.15rem;
    margin: 0.35rem 0 1rem 0;
    color: var(--color-primary-dark);
  }

  .quick-facts-table {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.82rem;
    margin-bottom: 1.5rem;
  }

  .qf-row {
    border-bottom: 1px solid rgba(222, 205, 183, 0.6);
    padding-bottom: 0.6rem;
  }

  .qf-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .qf-key {
    display: block;
    font-weight: 700;
    color: var(--color-primary-dark);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    margin-bottom: 0.15rem;
  }

  .qf-val {
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .highlight-green {
    color: var(--color-green-cta) !important;
    font-weight: 700;
  }

  .highlight-gold {
    color: var(--color-gold-deep) !important;
    font-weight: 700;
  }

  .b2b-side-text {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .pre-trip-side-list {
    list-style: disc;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  @media (max-width: 768px) {
    .founder-box {
      flex-direction: column;
      text-align: center;
    }
    .guarantees-grid {
      grid-template-columns: 1fr;
    }
    .fleet-feature-badges {
      grid-template-columns: 1fr;
    }
  }
</style>

