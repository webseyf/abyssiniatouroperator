---
import MainLayout from '../layouts/MainLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../config/site';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Abyssinian Tour Operator | Direct Inbound DMC & Tour Operator Ethiopia",
  "description": "About Abyssinian Tour Operator: 20+ years of native ground execution, direct Toyota 4x4 fleet ownership, accredited by the Ethiopian Ministry of Tourism, led by founder Dessiew Abunie Dejenie.",
  "publisher": {
    "@type": "TravelAgency",
    "name": siteConfig.companyName,
    "url": "https://abyssiniatouroperator.com",
    "telephone": siteConfig.contact.phone
  }
};
---

<MainLayout 
  title="About Us | Abyssinian Tour Operator — Direct Inbound DMC & Tour Operator Ethiopia"
  description="Learn about Abyssinian Tour Operator, our founder Dessiew Abunie Dejenie, our direct Toyota 4x4 fleet ownership, and our 20+ years of native ground leadership across Ethiopia."
  image="/images/destinations/gondar-castles.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />

  <!-- Top DMC Sub-Header (Matching Client Wireframe) -->
  <section class="about-top-bar">
    <div class="container about-top-inner">
      <div class="about-top-left">
        <span class="about-top-tag">DIRECT INBOUND DMC &amp; TOUR OPERATOR</span>
        <span>20+ Years Native Field Leadership | Addis Ababa, Ethiopia</span>
      </div>
      <div class="about-top-right">
        <div class="field-badge-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
          <span>Badge for Direct Field Leadership</span>
        </div>
        <a href="/contact-us" class="btn btn-gold btn-sm">[ Request Quote ]</a>
      </div>
    </div>
  </section>

  <!-- Hero Triptych Banner (Matching Client Wireframe Montage) -->
  <section class="about-hero-triptych">
    <div class="triptych-images">
      <div class="triptych-col">
        <img src="/images/destinations/lalibela-st-george.jpg" alt="Lalibela Rock-Hewn Church" width="600" height="350" />
      </div>
      <div class="triptych-col">
        <img src="/images/destinations/simien-baboons.jpg" alt="Simien Mountains Gelada Baboons" width="600" height="350" />
      </div>
      <div class="triptych-col">
        <img src="/images/destinations/omo-valley-hamer.jpg" alt="South Omo Valley Native Traditions" width="600" height="350" />
      </div>
    </div>
    <div class="triptych-overlay">
      <div class="container text-center">
        <h1 class="about-hero-main-title">ABOUT ABYSSINIAN TOUR OPERATOR</h1>
        <p class="about-hero-sub">Direct field leadership | 100% Native Ground Ownership &amp; Fleet</p>
      </div>
    </div>
  </section>

  <!-- Main Editorial Layout -->
  <section class="section-pad about-content-section">
    <div class="container">
      <div class="about-layout-grid">
        
        <!-- ============================================================== -->
        <!-- LEFT COLUMN: OVERVIEW, 6 GUARANTEES, FEATURED EXPEDITIONS      -->
        <!-- ============================================================== -->
        <div class="about-left-col">
          
          <!-- Company Overview and Core Operational Guarantees -->
          <div class="card-sand about-block">
            <h2 class="about-sec-title">Company Overview and Core Operational Guarantees</h2>
            
            <p class="about-lead-prose">
              Founded and headquartered in Addis Ababa, <strong>Abyssinian Tour Operator</strong> is an officially accredited, direct inbound Destination Management Company (DMC) and licensed Tour Operator in Ethiopia. For over two decades, we have specialized in delivering high-end, bespoke private B2C expeditions and turnkey B2B ground handling for international travel partners across the Horn of Africa.
            </p>

            <!-- 6 Guarantees (3x2 Grid) -->
            <div class="guarantees-grid-3x2">
              
              <!-- 1. Our Story -->
              <div class="g-card">
                <div class="g-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                  </svg>
                </div>
                <div class="g-text">
                  <h3>Our Story</h3>
                  <p>Our company story &amp; 20+ years of uncompromised field leadership.</p>
                </div>
              </div>

              <!-- 2. Fleets & Equipment -->
              <div class="g-card">
                <div class="g-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                </div>
                <div class="g-text">
                  <h3>FLEETS &amp; EQUIPMENT</h3>
                  <p>Direct company ownership of heavy-duty Toyota Land Cruiser 4WD fleet.</p>
                </div>
              </div>

              <!-- 3. Sustainability -->
              <div class="g-card">
                <div class="g-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                </div>
                <div class="g-text">
                  <h3>SUSTAINABILITY</h3>
                  <p>Community-based tourism &amp; ethical village benefit-sharing.</p>
                </div>
              </div>

              <!-- 4. 12-Hour Turnaround -->
              <div class="g-card">
                <div class="g-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <div class="g-text">
                  <h3>12-HOUR TURNAROUND</h3>
                  <p>Guaranteed 12-hour turnaround for tailored itineraries and NET quotes.</p>
                </div>
              </div>

              <!-- 5. Rigorous Security -->
              <div class="g-card">
                <div class="g-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                </div>
                <div class="g-text">
                  <h3>RIGOROUS SECURITY</h3>
                  <p>Native security protocols, field escorts, and 24/7 satellite dispatch.</p>
                </div>
              </div>

              <!-- 6. Priority Flights -->
              <div class="g-card">
                <div class="g-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"></path>
                  </svg>
                </div>
                <div class="g-text">
                  <h3>DOMESTIC FLIGHT PRIORITY</h3>
                  <p>Priority Ethiopian Airlines bookings &amp; wilderness expedition catering.</p>
                </div>
              </div>

            </div>
          </div>

          <!-- Featured Expeditions Grid (Matching Mockup) -->
          <div class="card-sand about-block">
            <h2 class="about-sec-title">POPULAR FEATURED EXPEDITIONS</h2>
            <div class="about-tours-grid-2x2">
              
              <!-- Tour 1 -->
              <div class="about-tour-card">
                <div class="at-media">
                  <img src="/images/destinations/lalibela-st-george.jpg" alt="8 Historic North & Lalibela" width="400" height="220" loading="lazy" />
                </div>
                <div class="at-body">
                  <h3 class="at-title">8 Historic North &amp; Lalibela</h3>
                  <div class="at-meta">
                    <div><strong>Category:</strong> Cultural Heritage &amp; UNESCO Monoliths</div>
                    <div><strong>Route:</strong> Addis Ababa &rarr; Bahir Dar &rarr; Gondar &rarr; Lalibela</div>
                  </div>
                  <div class="at-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>12th-century UNESCO rock churches in Lalibela</li>
                      <li>Trek Simien Mountains to see endemic Gelada baboons</li>
                      <li>Private boat cruise to Lake Tana island monasteries</li>
                    </ul>
                  </div>
                  <div class="at-actions">
                    <a href="/tours/8-day-historic-north-lalibela-unesco-circuit" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="/contact-us" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

              <!-- Tour 2 -->
              <div class="about-tour-card">
                <div class="at-media">
                  <img src="/images/destinations/erta-ale-volcano.jpg" alt="4 Danakil Depression & Erta Ale" width="400" height="220" loading="lazy" />
                </div>
                <div class="at-body">
                  <h3 class="at-title">4 Danakil Depression &amp; Erta Ale</h3>
                  <div class="at-meta">
                    <div><strong>Category:</strong> Extreme Desert Expedition &amp; Erta Ale</div>
                    <div><strong>Route:</strong> Semera &rarr; Erta Ale &rarr; Dallol</div>
                  </div>
                  <div class="at-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>Trek to active lava lake of Erta Ale volcano</li>
                      <li>Hydrothermal sulfur terraces at Dallol</li>
                      <li>Heavy-duty Toyota 4x4 convoys with wilderness catering</li>
                    </ul>
                  </div>
                  <div class="at-actions">
                    <a href="/tours/4-day-danakil-depression-erta-ale-lava-lake" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="/contact-us" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

              <!-- Tour 3 -->
              <div class="about-tour-card">
                <div class="at-media">
                  <img src="/images/destinations/mursi-tribe.jpg" alt="South Omo Valley Tribal Safari" width="400" height="220" loading="lazy" />
                </div>
                <div class="at-body">
                  <h3 class="at-title">South Omo Valley Tribal Safari</h3>
                  <div class="at-meta">
                    <div><strong>Category:</strong> Ethnographic Safari &amp; Cultural Photography</div>
                    <div><strong>Route:</strong> Arba Minch &rarr; Jinka &rarr; Turmi &rarr; Mago NP</div>
                  </div>
                  <div class="at-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>Respectful cultural encounters with Hamer and Mursi</li>
                      <li>Attend authentic Hamer bull-jumping ceremonies</li>
                      <li>Private 4x4 transport with experienced native escorts</li>
                    </ul>
                  </div>
                  <div class="at-actions">
                    <a href="/tours/7-day-omo-valley-tribal-cultural-photography-safari" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="/contact-us" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

              <!-- Tour 4 -->
              <div class="about-tour-card">
                <div class="at-media">
                  <img src="/images/destinations/kaffa-coffee.jpg" alt="Nature & Birdwatching" width="400" height="220" loading="lazy" />
                </div>
                <div class="at-body">
                  <h3 class="at-title">Nature &amp; Birdwatching</h3>
                  <div class="at-meta">
                    <div><strong>Category:</strong> Wildlife &amp; Rift Valley Lakes</div>
                    <div><strong>Route:</strong> Addis Ababa &rarr; Bale Mountains &rarr; Rift Lakes</div>
                  </div>
                  <div class="at-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>Tracking rare endemic Ethiopian wolf on Sanetti Plateau</li>
                      <li>Great Rift Valley lake bird sanctuaries</li>
                      <li>Wild Arabica coffee origin rainforest exploration</li>
                    </ul>
                  </div>
                  <div class="at-actions">
                    <a href="/tours/7-day-bale-mountains-wilderness-ethiopian-wolf-safari" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="/contact-us" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>

        <!-- ============================================================== -->
        <!-- RIGHT COLUMN: FOUNDER, ETHOS, TRUST BOX, B2B, ADVISORY, FOOTER -->
        <!-- ============================================================== -->
        <aside class="about-right-col">
          
          <!-- Founder Profile Card (Matching Mockup) -->
          <div class="about-side-box founder-profile-box">
            <div class="founder-card-inner">
              <div class="founder-text-col">
                <span class="f-profile-label">Founder Profile</span>
                <blockquote class="f-profile-quote">
                  "Our direct native execution ensures complete reliability, safety, and authentic experiences for your travelers."
                </blockquote>
                <div class="f-profile-name">{siteConfig.founder.name}</div>
                <div class="f-profile-role">Founder &amp; Managing Director</div>
              </div>
              <div class="founder-image-col">
                <img src="/images/about/dessiew-field-expedition.jpg" alt={siteConfig.founder.name} width="110" height="110" class="f-avatar" />
              </div>
            </div>
          </div>

          <!-- Our Core Operational Ethos -->
          <div class="about-side-box">
            <h3 class="side-box-title">Our Core Operational Ethos</h3>
            <p class="side-box-lead">Our core of operations in Ethiopia creates distinct standards and authentic journeys.</p>

            <div class="ethos-list">
              <div class="ethos-item">
                <div class="ethos-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div class="ethos-content">
                  <h4>Direct Ownership</h4>
                  <p>Direct fleet ownership protects your privacy, safety, and eliminates broker markups.</p>
                </div>
              </div>

              <div class="ethos-item">
                <div class="ethos-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                </div>
                <div class="ethos-content">
                  <h4>100% Native Guides</h4>
                  <p>Certified multi-lingual native guides with deep ancestral ties and academic backgrounds.</p>
                </div>
              </div>

              <div class="ethos-item">
                <div class="ethos-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                <div class="ethos-content">
                  <h4>Rigorous Field Security</h4>
                  <p>Constant satellite monitoring, local scout escorts, and verified field security protocols.</p>
                </div>
              </div>

              <div class="ethos-item">
                <div class="ethos-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </div>
                <div class="ethos-content">
                  <h4>Ethical &amp; Sustainable Tourism</h4>
                  <p>Fair compensation for local hosts, respectful village photography, community support.</p>
                </div>
              </div>

              <div class="ethos-item">
                <div class="ethos-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="ethos-content">
                  <h4>Bespoke Luxury &amp; Comfort</h4>
                  <p>Best available heritage eco-lodges, premium mobile wilderness camps, private chefs.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Key Company Quick Facts (Trust Box) -->
          <div class="about-side-box trust-box-wrap">
            <h3 class="side-box-title">Key Company Quick Facts (Trust Box)</h3>
            
            <div class="trust-box-list">
              <div class="tb-item">
                <span class="tb-icon">🏛️</span>
                <div>
                  <strong>Direct Ownership:</strong>
                  <span>100% native Ethiopian ownership &amp; 12M+ ETB registered capital standing.</span>
                </div>
              </div>
              <div class="tb-item">
                <span class="tb-icon">📜</span>
                <div>
                  <strong>Accredited Standing:</strong>
                  <span>Federal Democratic Republic of Ethiopia Ministry of Tourism certified DMC.</span>
                </div>
              </div>
              <div class="tb-item">
                <span class="tb-icon">🛡️</span>
                <div>
                  <strong>Native Security:</strong>
                  <span>20+ years flawless safety record across Simiens, Danakil, and Omo.</span>
                </div>
              </div>
              <div class="tb-item">
                <span class="tb-icon">🌿</span>
                <div>
                  <strong>Ethical &amp; Sustainable:</strong>
                  <span>Direct village economic benefit and conservation compliance.</span>
                </div>
              </div>
              <div class="tb-item">
                <span class="tb-icon">📋</span>
                <div>
                  <strong>Turnkey Execution:</strong>
                  <span>Complete airport-to-airport ground execution with private 4x4 fleet.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 1. B2B PARTNER GATEWAY (Matching Mockup) -->
          <div class="about-side-box b2b-gateway-side">
            <span class="box-badge-tag">1. B2B PARTNER GATEWAY</span>
            <h4 class="b2b-side-title">Partner with Ethiopia's Leading Inbound Ground Operator</h4>
            <p class="b2b-side-desc">
              100% White-Label Execution &bull; Confidential Net Tariffs &bull; Safety &amp; Security Standards
            </p>
            <a href="/b2b" class="btn btn-gold btn-block" style="width: 100%; text-align: center;">
              [ Access B2B Partner Portal ]
            </a>
          </div>

          <!-- 2. CLIENT PRE-DEPARTURE ADVISORY (Matching Mockup) -->
          <div class="about-side-box advisory-side">
            <span class="box-badge-tag">2. CLIENT PRE-DEPARTURE ADVISORY</span>
            <div class="advisory-icon-row">
              <div class="adv-i-item">
                <span class="adv-i-icon">🛂</span>
                <span>Visa Processing</span>
              </div>
              <div class="adv-i-item">
                <span class="adv-i-icon">💵</span>
                <span>Currency &amp; Payments</span>
              </div>
              <div class="adv-i-item">
                <span class="adv-i-icon">🧳</span>
                <span>Packing Essentials</span>
              </div>
            </div>
            <a href="/travel-guide" class="btn btn-outline-gold btn-block" style="width: 100%; text-align: center; margin-top: 1rem;">
              [ Read Full Pre-Trip Packing Guide ]
            </a>
          </div>

          <!-- 7. FOOTER & DIRECT FIELD CONTACT DETAILS -->
          <div class="about-side-box contact-dispatch-box">
            <h4 class="dispatch-title">7. FOOTER &amp; DIRECT FIELD CONTACT DETAILS</h4>
            <div class="dispatch-body">
              <p><strong>Company Name:</strong> Abyssinian Tour Operator</p>
              <p><strong>Management:</strong> Led by Dessiew Abunie Dejenie (CEO &amp; Managing Director)</p>
              <p><strong>Headquarters:</strong> Addis Ababa, Ethiopia</p>
              <p><strong>Direct Mobile / WhatsApp:</strong> <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="link-gold">{siteConfig.contact.phoneDisplay}</a></p>
              <p><strong>B2B Agent Inquiry Email:</strong> <a href={`mailto:${siteConfig.contact.emails.b2b}`}>{siteConfig.contact.emails.b2b}</a></p>
              <p><strong>Official Scope:</strong> Licensed Inbound DMC &amp; Tour Operator (Historic North, Danakil, Omo Valley, Treks &amp; Safaris)</p>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar />
</MainLayout>

<style>
  /* Top DMC Sub-Header */
  .about-top-bar {
    background-color: #211c18;
    color: #e5dfd3;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
  }

  .about-top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .about-top-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #dfd7ca;
  }

  .about-top-tag {
    background-color: var(--color-gold);
    color: #1a1612;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.55rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .about-top-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .field-badge-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-gold);
    font-size: 0.78rem;
    font-weight: 700;
  }

  /* Hero Triptych Banner */
  .about-hero-triptych {
    position: relative;
    height: 340px;
    overflow: hidden;
    border-bottom: 2px solid var(--color-gold);
  }

  .triptych-images {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    height: 100%;
    width: 100%;
  }

  .triptych-col {
    height: 100%;
    overflow: hidden;
    background-color: #211c18;
  }

  .triptych-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8);
  }

  .triptych-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(20, 16, 12, 0.5) 0%, rgba(20, 16, 12, 0.75) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-hero-main-title {
    color: #FFFFFF;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .about-hero-sub {
    color: var(--color-gold);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  /* Main Editorial Layout (2-Column Grid) */
