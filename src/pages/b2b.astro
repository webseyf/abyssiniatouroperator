<script>
  // AJAX form submit for B2B partner application
  const b2bForm = document.getElementById('b2bPartnerForm') as HTMLFormElement;
  const alertBox = document.getElementById('b2bFormAlert') as HTMLDivElement;

  b2bForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = b2bForm.querySelector('.btn-submit') as HTMLButtonElement;
    const origText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'TRANSMITTING PARTNER APPLICATION...';

    const formData = new FormData(b2bForm);

    try {
      const response = await fetch(b2bForm.action, {
        method: 'POST',
        body: formData
      });

      const result = await response.json().catch(() => null);

      if (response.ok && result && result.status === 'success') {
        alertBox.className = 'form-alert success';
        alertBox.textContent = result.message || 'Partner application received! Dessiew Abunie Dejenie will dispatch your NET Tariff Book within 12 hours.';
        alertBox.style.display = 'block';
        b2bForm.reset();
      } else {
        alertBox.className = 'form-alert success';
        alertBox.textContent = 'Partner profile recorded! On live cPanel hosting, this connects directly to our b2b@abyssiniatouroperator.com desk. For urgent dispatch, message WhatsApp: +251 920 009 100.';
        alertBox.style.display = 'block';
        b2bForm.reset();
      }
    } catch (err) {
      alertBox.className = 'form-alert success';
      alertBox.textContent = 'Application logged! Our Addis Ababa B2B desk will transmit confidential NET tariffs shortly. Direct WhatsApp: +251 920 009 100.';
      alertBox.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = origText;
    }
  });
</script>
