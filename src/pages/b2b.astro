---
import MainLayout from '../layouts/MainLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../config/site';

const b2bSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "B2B Partner & Agent Portal | Wholesale NET Tariffs & White-Label DMC Ethiopia",
  "description": "Official B2B Gateway for international travel agencies and tour operators. 100% white-label ground execution, direct Toyota 4x4 fleet ownership, priority Ethiopian Airlines domestic ticketing, and confidential wholesale NET tariffs.",
  "publisher": {
    "@type": "TravelAgency",
    "name": siteConfig.companyName,
    "url": "https://abyssiniatouroperator.com",
    "telephone": siteConfig.contact.phone
  }
};
---

<MainLayout 
  title="B2B Partner & Agent Portal | Wholesale NET Tariffs & White-Label DMC Ethiopia"
  description="Official B2B Partner Portal for international travel agencies and tour wholesalers. 100% white-label ground execution, direct Toyota 4x4 fleet ownership, and confidential wholesale NET tariffs."
  image="/images/home/hero-b2b-safari.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(b2bSchema)} />

  <!-- Top Utility Bar (Matching Client Wireframe) -->
  <section class="b2b-top-utility-bar">
    <div class="container b2b-top-utility-inner">
      <div class="b2b-utility-title">
        <span class="utility-badge">B2B WHOLESALE GATEWAY</span>
        <span>White-Label Ground Handling | Wholesale NET Tariffs | Turnkey Ethiopia Operations</span>
      </div>
      <div class="b2b-utility-cta">
        <a href="#partnerFormSection" class="btn btn-gold btn-sm">[ Request Quote ]</a>
      </div>
    </div>
  </section>

  <!-- Main Editorial B2B Layout (Matching Client Wireframe) -->
  <section class="section-pad b2b-editorial-section">
    <div class="container">
      <div class="b2b-page-grid">
        
        <!-- ============================================================== -->
        <!-- LEFT COLUMN: SECTIONS 1, 2, FEATURED B2B EXPEDITIONS           -->
        <!-- ============================================================== -->
        <div class="b2b-left-column">
          
          <!-- 1. YOUR TRUSTED DIRECT GROUND OPERATOR IN ETHIOPIA -->
          <div class="b2b-hero-card" style="background-image: linear-gradient(rgba(18, 16, 14, 0.45), rgba(18, 16, 14, 0.65)), url('/images/home/hero-lalibela.jpg');">
            <div class="b2b-hero-card-inner">
              <span class="b2b-hero-label">DIRECT NATIVE INBOUND DMC &amp; TOUR OPERATOR</span>
              <h1 class="b2b-hero-main-title">YOUR TRUSTED DIRECT GROUND OPERATOR IN ETHIOPIA</h1>
              <p class="b2b-hero-subtitle">
                Direct field leadership | 100% Direct Fleet Ownership | Addis Ababa Headquarters
              </p>
            </div>
          </div>

          <!-- Direct DMC Value Proposition -->
          <div class="card-sand b2b-value-box">
            <h2 class="b2b-box-title">Direct DMC Value Proposition</h2>
            <p class="b2b-box-lead">
              Partner with a licensed inbound DMC and tour operator offering 100% white-label execution, confidential wholesale NET rates, and guaranteed 12-hour proposal turnarounds for your B2B travel desk.
            </p>

            <div class="b2b-prop-grid-2x2">
              
              <!-- Our Story -->
              <div class="prop-card">
                <div class="prop-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                </div>
                <div class="prop-text">
                  <h3>Our Story</h3>
                  <p>20+ years native field leadership across Ethiopia's master circuits with zero third-party broker markups.</p>
                </div>
              </div>

              <!-- Fleets & Equipment -->
              <div class="prop-card">
                <div class="prop-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                </div>
                <div class="prop-text">
                  <h3>FLEETS &amp; EQUIPMENT</h3>
                  <p>Direct ownership of heavy-duty Toyota Land Cruiser 4WD fleet, maintained to strict international standards.</p>
                </div>
              </div>

              <!-- 12-Hour Proposal Clock -->
              <div class="prop-card">
                <div class="prop-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <div class="prop-text">
                  <h3>12-HOUR TURNAROUND</h3>
                  <p>Guaranteed 12-hour turnaround for customized itinerary drafting, NET pricing, and high-res assets.</p>
                </div>
              </div>

              <!-- Sustainability & Safety -->
              <div class="prop-card">
                <div class="prop-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                </div>
                <div class="prop-text">
                  <h3>SUSTAINABILITY &amp; SAFETY</h3>
                  <p>Rigorous field security, certified native guides, ethical village protocols, and responsible local tourism.</p>
                </div>
              </div>

            </div>

            <!-- Two Action Buttons -->
            <div class="b2b-prop-actions">
              <a href="#partnerFormSection" class="btn btn-gold btn-md">
                Request Confidential NET Tariff Schedule
              </a>
              <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-green btn-md">
                Schedule B2B Video Consultation
              </a>
            </div>
          </div>

          <!-- THE ABYSSINIAN B2B ADVANTAGE -->
          <div class="card-sand b2b-value-box">
            <h2 class="b2b-box-title">THE ABYSSINIAN B2B ADVANTAGE</h2>
            <div class="advantage-four-cards">
              
              <div class="adv-card">
                <div class="adv-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                </div>
                <h3>White-label</h3>
                <p>White-label execution protects your brand &amp; client relationships from arrival to departure.</p>
              </div>

              <div class="adv-card">
                <div class="adv-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 6v6l4 2"></path>
                  </svg>
                </div>
                <h3>Direct Fleet</h3>
                <p>Profit margins protected; direct fleet without intermediary broker markups.</p>
              </div>

              <div class="adv-card">
                <div class="adv-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <polyline points="17 11 19 13 23 9"></polyline>
                  </svg>
                </div>
                <h3>Guide-Led</h3>
                <p>Direct native guides ensure high customer satisfaction and repeat client bookings.</p>
              </div>

              <div class="adv-card">
                <div class="adv-icon">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </div>
                <h3>Faster Sales</h3>
                <p>Guaranteed 12-hour turnaround to help your B2B sales desk close deals faster.</p>
              </div>

            </div>
          </div>

          <!-- FEATURED B2B EXPEDITIONS (Flagship 2x2 Grid Matching Mockup) -->
          <div class="card-sand b2b-value-box">
            <h2 class="b2b-box-title">POPULAR FEATURED B2B EXPEDITIONS</h2>
            <div class="b2b-tours-grid-2x2">
              
              <!-- Tour 1: 8 Historic North -->
              <div class="b2b-tour-card">
                <div class="b2b-tour-media">
                  <img src="/images/destinations/lalibela-st-george.jpg" alt="8 Historic North & Lalibela" width="400" height="220" loading="lazy" />
                </div>
                <div class="b2b-tour-body">
                  <h3 class="b2b-t-title">8 Historic North &amp; Lalibela</h3>
                  <div class="b2b-t-meta">
                    <div><strong>Category:</strong> Cultural Heritage &amp; UNESCO Monoliths</div>
                    <div><strong>Route:</strong> Addis Ababa &rarr; Bahir Dar &rarr; Gondar &rarr; Lalibela</div>
                  </div>
                  <div class="b2b-t-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>12th-century UNESCO rock-hewn churches in Lalibela</li>
                      <li>Simien Mountains escarpment &amp; Gelada baboons</li>
                      <li>Private boat cruise on Lake Tana to ancient island monasteries</li>
                    </ul>
                  </div>
                  <div class="b2b-t-actions">
                    <a href="/tours/8-day-historic-north-lalibela-unesco-circuit" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

              <!-- Tour 2: 4 Danakil Depression -->
              <div class="b2b-tour-card">
                <div class="b2b-tour-media">
                  <img src="/images/destinations/erta-ale-volcano.jpg" alt="4 Danakil Depression & Erta Ale" width="400" height="220" loading="lazy" />
                </div>
                <div class="b2b-tour-body">
                  <h3 class="b2b-t-title">4 Danakil Depression &amp; Erta Ale</h3>
                  <div class="b2b-t-meta">
                    <div><strong>Category:</strong> Extreme Desert Expedition &amp; Erta Ale Volcano</div>
                    <div><strong>Route:</strong> Semera &rarr; Erta Ale &rarr; Dallol &rarr; Semera</div>
                  </div>
                  <div class="b2b-t-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>Trek to active lava lake at Erta Ale volcano crater</li>
                      <li>Kaleidoscopic salt formations and sulfur springs at Dallol</li>
                      <li>Heavy-duty Toyota 4x4 convoys with private wilderness catering</li>
                    </ul>
                  </div>
                  <div class="b2b-t-actions">
                    <a href="/tours/4-day-danakil-depression-erta-ale-lava-lake" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

              <!-- Tour 3: South Omo Valley -->
              <div class="b2b-tour-card">
                <div class="b2b-tour-media">
                  <img src="/images/destinations/mursi-tribe.jpg" alt="South Omo Valley Tribal Safari" width="400" height="220" loading="lazy" />
                </div>
                <div class="b2b-tour-body">
                  <h3 class="b2b-t-title">South Omo Valley Tribal Safari</h3>
                  <div class="b2b-t-meta">
                    <div><strong>Category:</strong> Ethnographic Safari &amp; Cultural Photography</div>
                    <div><strong>Route:</strong> Arba Minch &rarr; Jinka &rarr; Turmi &rarr; Mago NP</div>
                  </div>
                  <div class="b2b-t-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>Respectful cultural encounters with Hamer and Mursi communities</li>
                      <li>Attend authentic Hamer bull-jumping and ceremonial dances</li>
                      <li>Expert native field leaders with deep ancestral ties</li>
                    </ul>
                  </div>
                  <div class="b2b-t-actions">
                    <a href="/tours/7-day-omo-valley-tribal-cultural-photography-safari" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

              <!-- Tour 4: Nature & Birdwatching -->
              <div class="b2b-tour-card">
                <div class="b2b-tour-media">
                  <img src="/images/destinations/kaffa-coffee.jpg" alt="Nature, Birdwatching & Coffee Origin" width="400" height="220" loading="lazy" />
                </div>
                <div class="b2b-tour-body">
                  <h3 class="b2b-t-title">Nature &amp; Birdwatching</h3>
                  <div class="b2b-t-meta">
                    <div><strong>Category:</strong> Wildlife, Endemics &amp; Rift Valley Lakes</div>
                    <div><strong>Route:</strong> Addis Ababa &rarr; Bale Mountains &rarr; Rift Lakes</div>
                  </div>
                  <div class="b2b-t-highlights">
                    <strong>Key Highlights:</strong>
                    <ul>
                      <li>Tracking rare endemic Ethiopian wolf on Sanetti Plateau</li>
                      <li>Great Rift Valley lake bird sanctuaries with thousands of pelicans</li>
                      <li>Wild Arabica coffee origin rainforest exploration</li>
                    </ul>
                  </div>
                  <div class="b2b-t-actions">
                    <a href="/tours/7-day-bale-mountains-wilderness-ethiopian-wolf-safari" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
                    <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>

        <!-- ============================================================== -->
        <!-- RIGHT COLUMN: FOUNDER, FLEET SPECS, MODELS, FORM, CONTACTS    -->
        <!-- ============================================================== -->
        <aside class="b2b-right-column">
          
          <!-- Top Gateway Header Ribbon -->
          <div class="b2b-gateway-ribbon">
            <span>International B2B Partner Gateway</span>
          </div>

          <!-- Founder Profile Card (Matching Mockup) -->
          <div class="b2b-side-card founder-profile-card">
            <div class="founder-card-layout">
              <div class="founder-info-side">
                <span class="founder-subhead">Founder Profile</span>
                <blockquote class="founder-quote">
                  "Our direct native execution ensures complete reliability, safety, and authentic experiences for your travelers."
                </blockquote>
                <div class="founder-author-name">{siteConfig.founder.name}</div>
                <div class="founder-author-title">CEO &amp; Managing Director</div>
              </div>
              <div class="founder-img-side">
                <img src="/images/about/dessiew-field-expedition.jpg" alt={siteConfig.founder.name} width="120" height="120" class="founder-crop" />
              </div>
            </div>
          </div>

          <!-- GROUND INFRASTRUCTURE & FLEET SPECIFICATIONS -->
          <div class="b2b-side-card">
            <h3 class="side-card-title">GROUND INFRASTRUCTURE &amp; FLEET SPECIFICATIONS</h3>
            
            <div class="fleet-spec-section">
              <div class="fleet-spec-subhead">A. Private 4x4 Transport Fleet</div>
              
              <!-- Two vehicle photos side-by-side -->
              <div class="side-fleet-photos">
                <div class="fleet-thumb">
                  <img src="/images/fleet/toyota-land-cruiser-76.jpg" alt="Toyota Land Cruiser 76 Series" width="160" height="95" />
                  <span>Toyota Land Cruiser 70 Series</span>
                </div>
                <div class="fleet-thumb">
                  <img src="/images/fleet/toyota-prado-4wd.jpg" alt="Toyota Land Cruiser Prado" width="160" height="95" />
                  <span>Toyota Prado 4WD</span>
                </div>
              </div>

              <ul class="fleet-bullet-list">
                <li>Toyota Land Cruiser 70 / Prado 4WDs</li>
                <li>Rigorous mechanical checks before every departure</li>
                <li>On-board GPS, sat phone, cooler, trauma kit</li>
              </ul>

              <!-- Icon badges row -->
              <div class="spec-badges-row">
                <span class="mini-spec-badge">❄️ A/C</span>
                <span class="mini-spec-badge">🛞 Dual Spares</span>
                <span class="mini-spec-badge">📡 Sat Phone</span>
                <span class="mini-spec-badge">📍 GPS</span>
                <span class="mini-spec-badge">🩹 First-Aid</span>
                <span class="mini-spec-badge">💧 Mineral Water</span>
              </div>

              <div class="fleet-spec-subhead" style="margin-top: 1rem;">B. Field Leadership &amp; Guide Team</div>
              <p class="side-desc-text">
                Profiles of certified multi-lingual guides (English, French, German, Italian, Spanish) with deep knowledge in archaeology, ethnography, and high-altitude logistics.
              </p>

              <div class="fleet-spec-subhead" style="margin-top: 0.85rem;">Wilderness Catering</div>
              <p class="side-desc-text">
                Mobile expedition field kitchens, professional wilderness chefs, hot 3-course meals, and specialized dietary accommodations.
              </p>
            </div>
          </div>

          <!-- B2B COOPERATION MODELS -->
          <div class="b2b-side-card">
            <h3 class="side-card-title">B2B COOPERATION MODELS</h3>
            
            <div class="coop-models-list">
              
              <div class="coop-item">
                <div class="coop-media">
                  <img src="/images/destinations/gondar-castles.jpg" alt="Ad-Hoc FIT & Private Groups" width="100" height="65" />
                </div>
                <div class="coop-info">
                  <h4>Ad-Hoc FIT &amp; Private Groups</h4>
                  <p>Tailor-made itineraries with rapid 12-hour quotation files and unbranded client vouchers.</p>
                </div>
              </div>

              <div class="coop-item">
                <div class="coop-media">
                  <img src="/images/fleet/abyssinian-highland-4x4-convoy.jpg" alt="Fixed Series Departures" width="100" height="65" />
                </div>
                <div class="coop-info">
                  <h4>Fixed Series Departures</h4>
                  <p>Guaranteed departures across Historic North, Danakil, and Omo Valley with pre-blocked allocations.</p>
                </div>
              </div>

              <div class="coop-item">
                <div class="coop-media">
                  <img src="/images/destinations/danakil-dallol.jpg" alt="MICE & Special Interest Charters" width="100" height="65" />
                </div>
                <div class="coop-info">
                  <h4>MICE &amp; Special Interest Charters</h4>
                  <p>Turnkey logistics for filming crews, photography workshops, and institutional expeditions.</p>
                </div>
              </div>

            </div>
          </div>

          <!-- BECOME A REGISTERED B2B PARTNER -->
          <div class="b2b-side-card partner-form-card" id="partnerFormSection">
            <h3 class="side-card-title form-title">BECOME A REGISTERED B2B PARTNER</h3>
            <p class="form-lead-note">
              Complete this verification to access our confidential NET Tariff Book and white-label assets:
            </p>

            <form id="b2bPartnerForm" action="/api/b2b-apply.php" method="POST" class="b2b-compact-form">
              <div class="c-form-group">
                <label for="agencyName">Agency Name *</label>
                <input type="text" id="agencyName" name="agencyName" placeholder="e.g. Apex Overland Travel" required />
              </div>

              <div class="c-form-row">
                <div class="c-form-group">
                  <label for="contactPerson">Contact Person *</label>
                  <input type="text" id="contactPerson" name="contactPerson" placeholder="Full Name" required />
                </div>
                <div class="c-form-group">
                  <label for="partnerRole">Role / Title *</label>
                  <input type="text" id="partnerRole" name="partnerRole" placeholder="e.g. Product Director" required />
                </div>
              </div>

              <div class="c-form-row">
                <div class="c-form-group">
                  <label for="partnerEmail">Business Email *</label>
                  <input type="email" id="partnerEmail" name="email" placeholder="partner@agency.com" required />
                </div>
                <div class="c-form-group">
                  <label for="partnerPhone">WhatsApp / Mobile *</label>
                  <input type="tel" id="partnerPhone" name="phone" placeholder="+44 20 ..." required />
                </div>
              </div>

              <div class="c-form-group">
                <label for="operatingCountry">Operating Country *</label>
                <select id="operatingCountry" name="operatingCountry" required>
                  <option value="" disabled selected>Select country...</option>
                  <option value="United Kingdom">United Kingdom</option>
                  <option value="Germany">Germany</option>
                  <option value="France">France</option>
                  <option value="United States">United States</option>
                  <option value="Canada">Canada</option>
                  <option value="Australia">Australia</option>
                  <option value="Italy">Italy</option>
                  <option value="Spain">Spain</option>
                  <option value="Netherlands">Netherlands</option>
                  <option value="Switzerland">Switzerland</option>
                  <option value="Other">Other International</option>
                </select>
              </div>

              <div class="c-form-group">
                <label for="primaryClientMarkets">Primary Client Markets</label>
                <input type="text" id="primaryClientMarkets" name="primaryClientMarkets" placeholder="e.g. High-End FIT, Small Cultural Groups" />
              </div>

              <div class="c-form-group">
                <label for="annualPassengers">Annual Passengers to Ethiopia</label>
                <select id="annualPassengers" name="annualPassengers">
                  <option value="1–10 Pax">1 – 10 Passengers</option>
                  <option value="11–30 Pax">11 – 30 Passengers</option>
                  <option value="31–50 Pax">31 – 50 Passengers</option>
                  <option value="50+ Pax (Series)">50+ Passengers (Series / Departures)</option>
                </select>
              </div>

              <div class="c-form-group">
                <label for="inquiryDetails">Inquiry Details</label>
                <textarea id="inquiryDetails" name="inquiryDetails" rows="3" placeholder="Tell us about your upcoming departures, routes, or requirements..."></textarea>
              </div>

              <div id="b2bFormAlert" class="form-alert" style="display: none; margin-bottom: 0.75rem;"></div>

              <button type="submit" class="btn btn-green btn-block btn-submit" style="width: 100%;">
                Submit Partner Inquiry &amp; Request NET Tariffs
              </button>
            </form>
          </div>

          <!-- DIRECT FIELD CONTACT DETAILS -->
          <div class="b2b-direct-contact-card">
            <h4 class="contact-card-title">DIRECT FIELD CONTACT DETAILS</h4>
            <div class="contact-card-body">
              <p><strong>Company Name:</strong> Abyssinian Tour Operator</p>
              <p><strong>Management:</strong> Led by Dessiew Abunie Dejenie (CEO &amp; Managing Director)</p>
              <p><strong>Headquarters:</strong> Addis Ababa, Ethiopia</p>
              <p><strong>Direct Mobile / WhatsApp:</strong> <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="link-gold">{siteConfig.contact.phoneDisplay}</a></p>
              <p><strong>B2B Agent Inquiry Email:</strong> <a href={`mailto:${siteConfig.contact.emails.b2b}`}>{siteConfig.contact.emails.b2b}</a></p>
              <p><strong>Official Scope:</strong> Licensed Inbound DMC &amp; Tour Operator (Historic North, Danakil, Omo Valley, Treks &amp; Safaris)</p>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar />
</MainLayout>

<style>
  /* Top Utility Bar */
  .b2b-top-utility-bar {
    background-color: #211c18;
    color: #e5dfd3;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
  }

  .b2b-top-utility-inner {
    display: flex;
    align-items: center;
