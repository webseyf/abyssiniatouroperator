---
import MainLayout from '../layouts/MainLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../config/site';

const b2bSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "B2B Partner & Agent Portal | Wholesale NET Tariffs & White-Label DMC Ethiopia",
  "description": "Official B2B Gateway for international travel agencies and tour operators. 100% white-label ground execution, direct Toyota 4x4 fleet ownership, priority Ethiopian Airlines domestic ticketing, and confidential wholesale NET tariffs.",
  "publisher": {
    "@type": "TravelAgency",
    "name": siteConfig.companyName,
    "url": "https://abyssiniatouroperator.com",
    "telephone": siteConfig.contact.phone
  }
};
---

<MainLayout 
  title="B2B Partner & Agent Portal | Wholesale NET Tariffs & White-Label DMC Ethiopia"
  description="Official B2B Partner Portal for international travel agencies and tour wholesalers. 100% white-label ground execution, direct Toyota 4x4 fleet ownership, and confidential wholesale NET tariffs."
  image="/images/home/hero-b2b-safari.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(b2bSchema)} />

  <!-- Top Wholesale Utility Bar -->
  <section class="b2b-top-utility-bar">
    <div class="container b2b-top-utility-inner">
      <div class="b2b-utility-title">
        <span class="utility-badge">B2B WHOLESALE GATEWAY</span>
        <span>White-Label Ground Handling | Wholesale NET Tariffs | Turnkey Ethiopia Operations</span>
      </div>
      <div class="b2b-utility-cta">
        <a href="#partnerFormSection" class="btn btn-gold btn-sm">[ Request Quote ]</a>
      </div>
    </div>
  </section>

  <!-- Hero Section (Matching Client Layout) -->
  <section class="b2b-hero-banner" style="background-image: linear-gradient(rgba(18, 16, 14, 0.55), rgba(18, 16, 14, 0.72)), url('/images/home/hero-b2b-safari.jpg');">
    <div class="container b2b-hero-container text-center">
      <span class="b2b-hero-tag">WHITE-LABEL GROUND HANDLING | WHOLESALE NET TARIFFS | TURNKEY ETHIOPIA OPERATIONS</span>
      <h1 class="b2b-hero-h1">YOUR TRUSTED DIRECT GROUND OPERATOR IN ETHIOPIA</h1>
      <p class="b2b-hero-lead">
        Partner with a licensed inbound DMC and tour operator offering 100% white-label execution, confidential wholesale NET rates, and guaranteed 12-hour proposal turnarounds for your B2B travel desk.
      </p>

      <div class="b2b-hero-btn-row">
        <a href="#partnerFormSection" class="btn btn-gold btn-lg">
          Request Confidential NET Tariff Schedule
        </a>
        <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-white btn-lg">
          Schedule B2B Video Consultation
        </a>
      </div>

      <!-- Trust Strip with 3 Badges -->
      <div class="b2b-hero-trust-strip">
        <div class="trust-badge-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <div>
            <strong>MOT Accredited</strong>
            <span>Ministry of Tourism Licensed</span>
          </div>
        </div>
        <div class="trust-badge-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          <div>
            <strong>Direct Fleet</strong>
            <span>100% 4x4 Fleet Ownership</span>
          </div>
        </div>
        <div class="trust-badge-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <div>
            <strong>24/7 Dispatch</strong>
            <span>Addis Ababa Operations Hub</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 1. THE ABYSSINIAN B2B ADVANTAGE (Comparison Matrix)            -->
  <!-- ============================================================== -->
  <section class="section-pad advantage-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label">PARTNER VALUE PROPOSITION</span>
        <h2 class="sec-title-gold">THE ABYSSINIAN B2B ADVANTAGE</h2>
        <p class="sec-subtitle">Why leading European and North American tour operators rely on our ground operations:</p>
      </div>

      <div class="advantage-matrix-grid">
        
        <!-- Pillar 1: 100% White-Label -->
        <div class="adv-col-card">
          <div class="adv-col-header">
            <div class="adv-col-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            </div>
            <h3>100% White-Label</h3>
          </div>
          <div class="adv-col-body">
            <div class="adv-feature-row">
              <strong>Brand Protection:</strong> Unbranded 4x4s, professional field guides, and vouchers displaying only your logo.
            </div>
            <div class="adv-feature-row">
              <strong>Direct Discretion:</strong> Complete client firewall ensures repeat travelers remain exclusively yours.
            </div>
            <div class="adv-feature-row">
              <strong>Seamless Delivery:</strong> Airport VIP meet &amp; greet managed under your agency identity.
            </div>
          </div>
        </div>

        <!-- Pillar 2: Direct NET Rates -->
        <div class="adv-col-card">
          <div class="adv-col-header">
            <div class="adv-col-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <h3>Direct NET Rates</h3>
          </div>
          <div class="adv-col-body">
            <div class="adv-feature-row">
              <strong>Zero Broker Markup:</strong> Direct lodge contracts and company fleet ownership maximize margins (15%–30%).
            </div>
            <div class="adv-feature-row">
              <strong>Tiered Partner Tariffs:</strong> Progressive discounts based on seasonal volume and repeat bookings.
            </div>
            <div class="adv-feature-row">
              <strong>Transparent Line Items:</strong> Itemized costs for permits, vehicles, domestic flights, and lodges.
            </div>
          </div>
        </div>

        <!-- Pillar 3: 12-Hour Proposal -->
        <div class="adv-col-card">
          <div class="adv-col-header">
            <div class="adv-col-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3>12-Hour Turnaround</h3>
          </div>
          <div class="adv-col-body">
            <div class="adv-feature-row">
              <strong>Rapid Proposals:</strong> Guaranteed 12-hour turnaround for customized itinerary drafting and quotes.
            </div>
            <div class="adv-feature-row">
              <strong>High-Res Image Bank:</strong> Unbranded photo and video assets to help your marketing team sell.
            </div>
            <div class="adv-feature-row">
              <strong>Day-by-Day Route Logs:</strong> Turnkey logistical dossiers ready to forward straight to your travelers.
            </div>
          </div>
        </div>

        <!-- Pillar 4: Priority Flight Issuance -->
        <div class="adv-col-card">
          <div class="adv-col-header">
            <div class="adv-col-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"></path></svg>
            </div>
            <h3>Priority Flight Issuance</h3>
          </div>
          <div class="adv-col-body">
            <div class="adv-feature-row">
              <strong>Direct Airline Access:</strong> Priority booking on Ethiopian Airlines regional network.
            </div>
            <div class="adv-feature-row">
              <strong>Baggage Protection:</strong> Guaranteed 20 kg checked + 7 kg carry-on domestic allocations.
            </div>
            <div class="adv-feature-row">
              <strong>Schedule Safeguards:</strong> Live monitoring of connection times between Bole domestic &amp; international flights.
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 2. GROUND INFRASTRUCTURE & FLEET SPECIFICATIONS                -->
  <!-- ============================================================== -->
  <section class="section-pad infrastructure-section">
    <div class="container">
      <div class="infrastructure-box card-sand">
        <div class="infra-header text-center">
          <span class="section-label">LOGISTICAL HARDWARE</span>
          <h2 class="sec-title-gold">GROUND INFRASTRUCTURE &amp; FLEET SPECIFICATIONS</h2>
          <p class="sec-subtitle">Purpose-built 4WD hardware and seasoned native personnel for high-end operations:</p>
        </div>

        <div class="infra-dual-grid">
          
          <!-- Column A: Private 4x4 Transport Fleet -->
          <div class="infra-col-card">
            <h3 class="infra-subhead">A. Private 4x4 Transport Fleet</h3>
            
            <div class="fleet-photos-duo">
              <div class="fleet-img-wrap">
                <img src="/images/fleet/toyota-land-cruiser-76.jpg" alt="Toyota Land Cruiser 70 Series" width="300" height="170" />
                <span class="fleet-caption">Toyota Land Cruiser 70 Series</span>
              </div>
              <div class="fleet-img-wrap">
                <img src="/images/fleet/toyota-prado-4wd.jpg" alt="Toyota Land Cruiser Prado" width="300" height="170" />
                <span class="fleet-caption">Toyota Prado 4WD</span>
              </div>
            </div>

            <div class="fleet-specs-content">
              <h4>Toyota Land Cruiser 70 / Prado 4WDs</h4>
              <ul class="fleet-bullets">
                <li>Pre-expedition multi-point mechanical inspection before departure</li>
                <li>Dual heavy-duty A/C systems engineered for 45&deg;C+ Danakil heat</li>
                <li>3-point seatbelts on all passenger seats conforming to international standards</li>
                <li>Emergency satellite phone, GPS tracking, and comprehensive trauma kit</li>
                <li>Chilled mineral water replenished daily</li>
              </ul>

              <div class="infra-pills-row">
                <span class="infra-pill">❄️ A/C Climate</span>
                <span class="infra-pill">🛞 Dual Spares</span>
                <span class="infra-pill">📡 Sat Phone</span>
                <span class="infra-pill">📍 GPS Tracking</span>
                <span class="infra-pill">🩹 First-Aid</span>
                <span class="infra-pill">💧 Mineral Water</span>
              </div>
            </div>
          </div>

          <!-- Column B: Field Leadership & Guide Team -->
          <div class="infra-col-card">
            <h3 class="infra-subhead">B. Field Leadership &amp; Guide Team</h3>
            
            <div class="team-lead-rows">
              
              <div class="team-lead-item">
                <div class="team-avatar">
                  <img src="/images/about/dessiew-director.jpg" alt="Certified Expedition Guide" width="65" height="65" />
                </div>
                <div class="team-lead-info">
                  <h4>Expedition Guides</h4>
                  <p>Certified multi-lingual guides (English, French, German, Italian, Spanish) with academic backgrounds in history, archaeology, and ethnography.</p>
                </div>
              </div>

              <div class="team-lead-item">
                <div class="team-avatar">
                  <img src="/images/about/dessiew-field-expedition.jpg" alt="Veteran Cross-Country Driver" width="65" height="65" />
                </div>
                <div class="team-lead-info">
                  <h4>Expedition Drivers</h4>
                  <p>Veteran 4x4 drivers trained in defensive driving, mechanical field troubleshooting, and harsh desert navigation across Danakil and Omo.</p>
                </div>
              </div>

              <div class="team-lead-item">
                <div class="team-avatar">
                  <img src="/images/about/dessiew-abunie-dejenie.jpg" alt="Wilderness Camp Chef" width="65" height="65" />
                </div>
                <div class="team-lead-info">
                  <h4>Wilderness Catering</h4>
                  <p>Mobile expedition kitchens with private field chefs serving hot 3-course meals during eco-camping, catering to all dietary requirements.</p>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 3. B2B COOPERATION MODELS                                      -->
  <!-- ============================================================== -->
  <section class="section-pad models-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label">PARTNERSHIP FORMATS</span>
        <h2 class="sec-title-gold">B2B COOPERATION MODELS</h2>
        <p class="sec-subtitle">Flexible integration options for independent agencies, wholesalers, and specialized operators:</p>
      </div>

      <div class="coop-cards-3col">
        
        <div class="coop-card">
          <div class="coop-card-media">
            <img src="/images/destinations/gondar-castles.jpg" alt="Ad-Hoc FIT & Private Groups" width="400" height="220" />
            <span class="coop-card-badge">TAILOR-MADE</span>
          </div>
          <div class="coop-card-body">
            <h3>Ad-Hoc FIT &amp; Private Groups</h3>
            <p>Bespoke custom itineraries for high-net-worth individual travelers, couples, or private family departures.</p>
            <ul class="coop-bullets">
              <li>12-hour quotation delivery</li>
              <li>Fully customizable circuits</li>
              <li>Unbranded white-label client vouchers</li>
            </ul>
          </div>
        </div>

        <div class="coop-card">
          <div class="coop-card-media">
            <img src="/images/fleet/abyssinian-highland-4x4-convoy.jpg" alt="Fixed Series Departures" width="400" height="220" />
            <span class="coop-card-badge">CATALOG INTEGRATION</span>
          </div>
          <div class="coop-card-body">
            <h3>Fixed Series Departures</h3>
            <p>Guaranteed group departures across peak season (October &ndash; April) for integration into your brochure or website.</p>
            <ul class="coop-bullets">
              <li>Guaranteed departures (2 pax minimum)</li>
              <li>Pre-blocked hotel &amp; flight allocations</li>
              <li>Volume override commission tiers</li>
            </ul>
          </div>
        </div>

        <div class="coop-card">
          <div class="coop-card-media">
            <img src="/images/destinations/danakil-dallol.jpg" alt="MICE & Special Interest Charters" width="400" height="220" />
            <span class="coop-card-badge">EXPEDITION &amp; MICE</span>
          </div>
          <div class="coop-card-body">
            <h3>MICE &amp; Special Interest Charters</h3>
            <p>Turnkey field logistics for documentary filming crews, geological research, corporate retreats, and photo workshops.</p>
            <ul class="coop-bullets">
              <li>Filming permit facilitation with Ministry</li>
              <li>Satellite communication &amp; field power</li>
              <li>Dedicated senior logistical director</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 4. POPULAR FEATURED B2B EXPEDITIONS (Flagship Grid)            -->
  <!-- ============================================================== -->
  <section class="section-pad featured-b2b-tours-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label">CONFIDENTIAL WHOLESALE CATALOG</span>
        <h2 class="sec-title-gold">POPULAR FEATURED B2B EXPEDITIONS</h2>
        <p class="sec-subtitle">Proven master itineraries with standardized operating procedures and white-label delivery:</p>
      </div>

      <div class="b2b-tours-grid-4col">
        
        <!-- Tour 1 -->
        <div class="b2b-t-card">
          <div class="b2b-t-img">
            <img src="/images/destinations/lalibela-st-george.jpg" alt="8 Historic North & Lalibela" width="360" height="210" loading="lazy" />
          </div>
          <div class="b2b-t-body">
            <h3>8 Historic North &amp; Lalibela</h3>
            <div class="b2b-meta">
              <div><strong>Category:</strong> Cultural Heritage &amp; Monoliths</div>
              <div><strong>Route:</strong> Addis Ababa &rarr; Lalibela</div>
            </div>
            <div class="b2b-highs">
              <strong>Key Highlights:</strong>
              <ul>
                <li>12th-century UNESCO rock-hewn churches</li>
                <li>Simien Mountains Gelada baboon escarpment</li>
                <li>Private boat cruise on Lake Tana</li>
              </ul>
            </div>
            <div class="b2b-btns">
              <a href="/tours/8-day-historic-north-lalibela-unesco-circuit" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
              <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
            </div>
          </div>
        </div>

        <!-- Tour 2 -->
        <div class="b2b-t-card">
          <div class="b2b-t-img">
            <img src="/images/destinations/erta-ale-volcano.jpg" alt="4 Danakil Depression & Erta Ale" width="360" height="210" loading="lazy" />
          </div>
          <div class="b2b-t-body">
            <h3>4 Danakil Depression &amp; Erta Ale</h3>
            <div class="b2b-meta">
              <div><strong>Category:</strong> Extreme Desert &amp; Volcano</div>
              <div><strong>Route:</strong> Semera &rarr; Erta Ale &rarr; Dallol</div>
            </div>
            <div class="b2b-highs">
              <strong>Key Highlights:</strong>
              <ul>
                <li>Active lava lake crater ascent at night</li>
                <li>Hydrothermal sulfur fields at Dallol</li>
                <li>Heavy-duty 4x4 convoys with wilderness chef</li>
              </ul>
            </div>
            <div class="b2b-btns">
              <a href="/tours/4-day-danakil-depression-erta-ale-lava-lake" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
              <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
            </div>
          </div>
        </div>

        <!-- Tour 3 -->
        <div class="b2b-t-card">
          <div class="b2b-t-img">
            <img src="/images/destinations/mursi-tribe.jpg" alt="South Omo Valley Tribal Safari" width="360" height="210" loading="lazy" />
          </div>
          <div class="b2b-t-body">
            <h3>South Omo Valley Tribal Safari</h3>
            <div class="b2b-meta">
              <div><strong>Category:</strong> Ethnographic &amp; Photography</div>
              <div><strong>Route:</strong> Arba Minch &rarr; Mago National Park</div>
            </div>
            <div class="b2b-highs">
              <strong>Key Highlights:</strong>
              <ul>
                <li>Respectful encounters with Hamer &amp; Mursi</li>
                <li>Authentic bull-jumping cultural rites</li>
                <li>Native field leadership protecting local dignity</li>
              </ul>
            </div>
            <div class="b2b-btns">
              <a href="/tours/7-day-omo-valley-tribal-cultural-photography-safari" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
              <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
            </div>
          </div>
        </div>

        <!-- Tour 4 -->
        <div class="b2b-t-card">
          <div class="b2b-t-img">
            <img src="/images/destinations/kaffa-coffee.jpg" alt="Nature, Wildlife & Birdwatching" width="360" height="210" loading="lazy" />
          </div>
          <div class="b2b-t-body">
            <h3>Nature &amp; Birdwatching</h3>
            <div class="b2b-meta">
              <div><strong>Category:</strong> Wildlife &amp; Rift Valley Lakes</div>
              <div><strong>Route:</strong> Addis Ababa &rarr; Bale Mountains</div>
            </div>
            <div class="b2b-highs">
              <strong>Key Highlights:</strong>
              <ul>
                <li>Endemic Ethiopian wolf on Sanetti Plateau</li>
                <li>Rift Valley lake aquatic bird sanctuaries</li>
                <li>Wild Arabica coffee origin rainforest walk</li>
              </ul>
            </div>
            <div class="b2b-btns">
              <a href="/tours/7-day-bale-mountains-wilderness-ethiopian-wolf-safari" class="btn btn-outline btn-sm">[ View Itinerary ]</a>
              <a href="#partnerFormSection" class="btn btn-gold btn-sm">Get Quote</a>
            </div>
          </div>
        </div>

      </div>

      <div class="text-center" style="margin-top: 2.5rem;">
        <a href="/tours" class="btn btn-gold btn-lg">[ Explore Itineraries ]</a>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 5. RISK MANAGEMENT & SAFETY                                    -->
  <!-- ============================================================== -->
  <section class="section-pad risk-section">
    <div class="container">
      <div class="risk-box card-sand">
        <div class="risk-header text-center">
          <span class="section-label">DUTY OF CARE</span>
          <h2 class="sec-title-gold">RISK MANAGEMENT &amp; SAFETY</h2>
          <p class="sec-subtitle">Institutional security, crisis protocols, and regional permits handled seamlessly:</p>
        </div>

        <div class="risk-cards-3col">
          
          <div class="risk-card">
            <div class="risk-card-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3>24/7 Operations Manager</h3>
            <p>
              Dedicated Addis Ababa operations officers tracking vehicle GPS coordinates, local weather, and domestic flight schedules in real time.
            </p>
          </div>

          <div class="risk-card">
            <div class="risk-card-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <h3>Pre-Cleared Permits</h3>
            <p>
              All tribal village clearances, community elder permissions, national park warden escorts, and road transit permits are cleared prior to guest arrival.
            </p>
          </div>

          <div class="risk-card">
            <div class="risk-card-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            </div>
            <h3>Crisis Protocol</h3>
            <p>
              Established emergency response plans, 24/7 road assistance, direct contact with regional authorities, and coordinated air medical evacuation.
            </p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 6. BECOME A REGISTERED B2B PARTNER (Registration Form)         -->
  <!-- ============================================================== -->
  <section class="section-pad form-section" id="partnerFormSection">
    <div class="container">
      <div class="form-wrapper card-sand">
        <div class="form-header text-center">
          <span class="section-label">PARTNER VERIFICATION</span>
          <h2 class="sec-title-gold">BECOME A REGISTERED B2B PARTNER</h2>
