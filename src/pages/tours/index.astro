---
import MainLayout from '../../layouts/MainLayout.astro';
import TourCard from '../../components/TourCard.astro';
import TrustBar from '../../components/TrustBar.astro';
import { allTours, tourPillars } from '../../data/tours';
import { siteConfig } from '../../config/site';
---

<MainLayout 
  title="All 20 Ethiopia Tour Itineraries | Abyssinian Tour Operator Master Catalogue"
  description="Explore our master catalogue of 20 curated Ethiopian tour itineraries across 5 core pillars: Historic North, Danakil Lava Expeditions, South Omo Valley Safaris, Kaffa Coffee Origins, and Grand Circuits."
  image="/images/home/hero-tours-simien.jpg"
>
  <!-- Page Hero -->
  <section class="page-hero" style="background-image: url('/images/home/hero-tours-simien.jpg');">
    <div class="container">
      <span class="section-label light">DIRECT INBOUND DMC GROUND OPERATIONS | ADDIS ABABA, ETHIOPIA</span>
      <h1>Master Catalogue of 20 Ethiopia Itineraries</h1>
      <p class="subtitle">
        Curated day-by-day expedition routes covering ancient UNESCO monolithic sanctuaries, active rift volcanoes, pristine cloud rainforests, and remote indigenous homelands.
      </p>
    </div>
  </section>

  <!-- Filter & Search Toolbar -->
  <section class="catalog-toolbar">
    <div class="container toolbar-inner">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input 
          type="text" 
          id="tourSearchInput" 
          placeholder="Search by destination (e.g. Lalibela, Danakil, Omo, Simien)..." 
          aria-label="Search tour itineraries"
        />
      </div>

      <div class="pillar-filter-pills" role="tablist">
        <button type="button" class="filter-pill active" data-pillar="all">
          All 20 Tours
        </button>
        {tourPillars.map(p => (
          <button type="button" class="filter-pill" data-pillar={p.id}>
            {p.name}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Tour Grid Section -->
  <section class="section-pad">
    <div class="container">
      <!-- Active Results Counter -->
      <div class="catalog-status-bar">
        <span id="resultsCount">Showing all <strong>20</strong> master itineraries</span>
        <span class="dmc-guarantee-tag">Direct Local Operator Tariffs &bull; Zero Broker Markups</span>
      </div>

      <div class="tours-master-grid" id="toursGrid">
        {allTours.map(tour => (
          <TourCard tour={tour} />
        ))}
      </div>

      <div id="noResults" class="no-results" style="display: none;">
        <h3>No matching itineraries found</h3>
        <p>Try searching for a different destination (e.g., Lalibela, Danakil, Omo, Simien, Bale, Harar, Addis).</p>
        <button type="button" class="btn btn-gold btn-sm" id="resetFilters">Reset Filters</button>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar />

  <!-- B2B Wholesale Callout -->
  <section class="section-pad" style="background-color: #FAF4EB; border-top: 1px solid var(--color-sand-border);">
    <div class="container text-center">
      <span class="section-label">TRAVEL TRADE & WHOLESALERS</span>
      <h2>Require White-Label Tour Itineraries for Your Agency?</h2>
      <p style="max-width: 720px; margin: 0.75rem auto 1.75rem auto; color: var(--color-text-muted);">
        All 20 master itineraries are available under your agency brand with unbranded 4x4 vehicles, white-label field documentation, and confidential wholesale NET tariffs.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/b2b" class="btn btn-green btn-lg">
          ACCESS B2B AGENT PORTAL & NET TARIFFS
        </a>
        <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg">
          WHATSAPP DISPATCH: {siteConfig.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .catalog-toolbar {
    background-color: #241D17;
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    padding: 1.25rem 0;
    position: sticky;
    top: 72px;
    z-index: 100;
  }

  .toolbar-inner {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background-color: #1A1512;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.85rem;
    color: #FFFFFF;
    flex: 1;
    max-width: 440px;
  }

  .search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 0.88rem;
    width: 100%;
  }

  .search-box input::placeholder {
    color: #A39686;
  }

  .pillar-filter-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #E2D7C8;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
  }

  .filter-pill.active {
    background: var(--color-gold);
    color: #FFFFFF;
    border-color: var(--color-gold);
  }

  .catalog-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-sand-border);
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .dmc-guarantee-tag {
    color: var(--color-gold-deep);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tours-master-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    background-color: var(--color-sand-card);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-sand-border);
  }

  .no-results h3 {
    margin-bottom: 0.5rem;
  }

  .no-results p {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .text-center {
    text-align: center;
  }

  @media (max-width: 1200px) {
    .tours-master-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .tours-master-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .catalog-toolbar {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .tours-master-grid {
      grid-template-columns: 1fr;
    }
    .catalog-status-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  // Search and Pillar Filter functionality
  const searchInput = document.getElementById('tourSearchInput') as HTMLInputElement;
  const filterPills = document.querySelectorAll('.filter-pill');
  const cards = document.querySelectorAll('.tour-card');
  const resultsCount = document.getElementById('resultsCount');
  const noResults = document.getElementById('noResults');
  const resetBtn = document.getElementById('resetFilters');

  let activePillar = 'all';
  let searchTerm = '';

  // Check URL parameters for initial filter
  const params = new URLSearchParams(window.location.search);
  const paramPillar = params.get('pillar');
  const paramSearch = params.get('search');

  if (paramPillar) {
    activePillar = paramPillar;
    filterPills.forEach(p => {
      p.classList.toggle('active', p.getAttribute('data-pillar') === paramPillar);
    });
  }

  if (paramSearch) {
    searchTerm = paramSearch.toLowerCase();
    if (searchInput) searchInput.value = paramSearch;
  }

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach(card => {
      const cardPillar = card.getAttribute('data-pillar');
      const cardText = (card.textContent || '').toLowerCase();

      const matchesPillar = activePillar === 'all' || cardPillar === activePillar;
      const matchesSearch = !searchTerm || cardText.includes(searchTerm);

      if (matchesPillar && matchesSearch) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.innerHTML = `Showing <strong>${visibleCount}</strong> of 20 itineraries`;
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activePillar = pill.getAttribute('data-pillar') || 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });

  resetBtn?.addEventListener('click', () => {
    activePillar = 'all';
    searchTerm = '';
    if (searchInput) searchInput.value = '';
    filterPills.forEach(p => p.classList.toggle('active', p.getAttribute('data-pillar') === 'all'));
    applyFilters();
  });

  // Run on initial load
  applyFilters();
</script>

