---
import MainLayout from '../layouts/MainLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../config/site';
import { allTours } from '../data/tours';
---

<MainLayout 
  title="Tour Inquiry Form & Contact | Abyssinia Tour Operator Addis Ababa"
  description="Official Tour Inquiry Form for international travelers and B2B partners. Tailor-made itineraries, private 4x4 overland expeditions, and cultural circuits across Ethiopia."
  image="/images/home/hero-contact-addis.jpg"
>
  <!-- Page Hero -->
  <section class="page-hero" style="background-image: url('/images/home/hero-contact-addis.jpg');">
    <div class="container">
      <span class="section-label light">24/7 ADDIS ABABA DISPATCH & INQUIRY DESK</span>
      <h1>TOUR INQUIRY & CONTACT</h1>
      <p class="subtitle">
        Bespoke Expeditions, Cultural Circuits & Turnkey Ground Handling in Ethiopia. Complete our official inquiry form below for a custom quotation and logistical plan within 12 hours.
      </p>
    </div>
  </section>

  <!-- Section: Quick Contact Strip -->
  <section class="quick-contact-section">
    <div class="container">
      <div class="quick-contact-grid">
        <!-- Phone & WhatsApp -->
        <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="qc-card whatsapp-qc">
          <div class="qc-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="qc-content">
            <span class="qc-label">24/7 DIRECT FIELD DISPATCH</span>
            <strong>{siteConfig.contact.phoneDisplay}</strong>
            <span class="qc-sub">WhatsApp & Urgent Ground Coordination</span>
          </div>
        </a>

        <!-- General Email -->
        <a href={`mailto:${siteConfig.contact.emails.general}`} class="qc-card">
          <div class="qc-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="qc-content">
            <span class="qc-label">GENERAL INQUIRIES & BOOKINGS</span>
            <strong>{siteConfig.contact.emails.general}</strong>
            <span class="qc-sub">Guaranteed 12-Hour Proposal Turnaround</span>
          </div>
        </a>

        <!-- B2B Desk -->
        <a href={`mailto:${siteConfig.contact.emails.b2b}`} class="qc-card">
          <div class="qc-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
          </div>
          <div class="qc-content">
            <span class="qc-label">B2B AGENT & DMC DESK</span>
            <strong>{siteConfig.contact.emails.b2b}</strong>
            <span class="qc-sub">Confidential Wholesale NET Tariffs</span>
          </div>
        </a>

        <!-- Office Address -->
        <div class="qc-card">
          <div class="qc-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div class="qc-content">
            <span class="qc-label">HEADQUARTERS & DISPATCH DESK</span>
            <strong>{siteConfig.contact.address.street}</strong>
            <span class="qc-sub">{siteConfig.contact.address.city}, Ethiopia</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Official Master Tour Inquiry Form -->
  <section class="inquiry-form-section">
    <div class="container">
      <div class="dossier-wrapper">
        <!-- Form Header Matching Official PDF -->
        <div class="dossier-header">
          <div class="dossier-brand-col">
            <div class="dossier-company-name">ABYSSINIA TOUR OPERATOR</div>
            <div class="dossier-company-sub">Bespoke Expeditions, Cultural Circuits & Ground Handling in Ethiopia</div>
          </div>
          <div class="dossier-title-col">
            <div class="dossier-doc-title">TOUR INQUIRY FORM</div>
            <div class="dossier-doc-sub">International Client & B2B Partner Request</div>
          </div>
        </div>

        <!-- Official Intro Notice -->
        <div class="dossier-intro-box">
          <p>
            Thank you for your interest in exploring Ethiopia with us. Please complete this form so our team can design a tailored itinerary, logistics plan, and quotation suited to your group's exact needs.
          </p>
        </div>

        <!-- Master Inquiry Form -->
        <form id="masterInquiryForm" action="/api/contact.php" method="POST" class="dossier-form">
          <input type="hidden" name="form_type" value="official_dossier" />
          <!-- Anti-Spam Honeypot Field -->
          <div style="display:none;" aria-hidden="true">
            <input type="text" name="website_hp_check" tabindex="-1" autocomplete="off" />
          </div>

          <!-- ==================================================================== -->
          <!-- 1. TRAVELER / PARTNER INFORMATION -->
          <!-- ==================================================================== -->
          <div class="dossier-section">
            <div class="dossier-section-title">
              <span class="sec-num">1.</span> TRAVELER / PARTNER INFORMATION
            </div>
            <div class="dossier-section-body">
              <div class="form-grid-2">
                <div class="form-group">
                  <label for="fullName" class="d-label">Full Name (Primary Contact) <span class="req">*</span></label>
                  <input type="text" id="fullName" name="fullName" class="d-input" placeholder="e.g. Dr. Marcus Vance / Elena Rostova" required />
                </div>
                <div class="form-group">
                  <label for="companyName" class="d-label">Company / Agency Name <span class="opt">(If B2B / Group Organizer)</span></label>
                  <input type="text" id="companyName" name="companyName" class="d-input" placeholder="e.g. Silk Road Expeditions / Private Group" />
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label for="email" class="d-label">Email Address <span class="req">*</span></label>
                  <input type="email" id="email" name="email" class="d-input" placeholder="primary.contact@domain.com" required />
                </div>
                <div class="form-group">
                  <label for="phone" class="d-label">Phone / WhatsApp Number (with Country Code) <span class="req">*</span></label>
                  <input type="tel" id="phone" name="phone" class="d-input" placeholder="+1 555 123 4567 or +44 7700 900077" required />
                </div>
              </div>

              <div class="form-grid-3">
                <div class="form-group">
                  <label for="country" class="d-label">Nationality / Country of Residence <span class="req">*</span></label>
                  <input type="text" id="country" name="country" class="d-input" placeholder="e.g. United Kingdom, USA, Germany" required />
                </div>
                <div class="form-group">
                  <label for="guideLanguage" class="d-label">Preferred Guide Language</label>
                  <select id="guideLanguage" name="guideLanguage" class="d-select">
                    <option value="English">English</option>
                    <option value="French">French (Français)</option>
                    <option value="German">German (Deutsch)</option>
                    <option value="Spanish">Spanish (Español)</option>
                    <option value="Italian">Italian (Italiano)</option>
                    <option value="Russian">Russian</option>
                    <option value="Chinese">Chinese (Mandarin)</option>
                    <option value="Other">Other / Specific Dialect</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="ageRange" class="d-label">Age Range of Travelers</label>
                  <input type="text" id="ageRange" name="ageRange" class="d-input" placeholder="e.g. 35–60 / Family with kids (8, 12)" />
                </div>
              </div>
            </div>
          </div>

          <!-- ==================================================================== -->
          <!-- 2. TRAVEL DATES & GROUP COMPOSITION -->
          <!-- ==================================================================== -->
          <div class="dossier-section">
            <div class="dossier-section-title">
              <span class="sec-num">2.</span> TRAVEL DATES & GROUP COMPOSITION
            </div>
            <div class="dossier-section-body">
              <div class="form-grid-3">
                <div class="form-group">
                  <label for="arrivalDate" class="d-label">Estimated Arrival Date <span class="req">*</span></label>
                  <input type="text" id="arrivalDate" name="arrivalDate" class="d-input" placeholder="e.g. 15 Oct 2026 or DD/MM/YYYY" required />
                </div>
                <div class="form-group">
                  <label for="departureDate" class="d-label">Estimated Departure Date <span class="req">*</span></label>
                  <input type="text" id="departureDate" name="departureDate" class="d-input" placeholder="e.g. 29 Oct 2026 or DD/MM/YYYY" required />
                </div>
                <div class="form-group">
                  <label for="duration" class="d-label">Total Duration (Days / Nights)</label>
                  <input type="text" id="duration" name="duration" class="d-input" placeholder="e.g. 10 Days / 9 Nights" />
                </div>
              </div>

              <div class="form-grid-3">
                <div class="form-group">
                  <label for="adults" class="d-label">Number of Adults <span class="req">*</span></label>
                  <input type="number" id="adults" name="adults" min="1" max="100" value="2" class="d-input" required />
                </div>
                <div class="form-group">
                  <label for="children" class="d-label">Number of Children (with Ages)</label>
                  <input type="text" id="children" name="children" class="d-input" placeholder="e.g. 0 or 2 Children (Ages 7, 11)" />
                </div>
                <div class="form-group">
                  <label class="d-label">Dates Flexible?</label>
                  <div class="flex-dates-row">
                    <label class="d-radio-label">
                      <input type="radio" name="datesFlexible" value="Yes" checked />
                      <span>Yes (±</span>
                      <input type="number" name="flexibleDays" class="d-input-inline" min="1" max="30" value="3" placeholder="3" />
                      <span>days)</span>
                    </label>
                    <label class="d-radio-label">
                      <input type="radio" name="datesFlexible" value="No (Fixed)" />
                      <span>No (Fixed)</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ==================================================================== -->
          <!-- 3. DESTINATIONS & TOUR INTERESTS -->
          <!-- ==================================================================== -->
          <div class="dossier-section">
            <div class="dossier-section-title">
              <span class="sec-num">3.</span> DESTINATIONS & TOUR INTERESTS
            </div>
            <div class="dossier-section-body">
              <!-- Preferred Regions & Circuits -->
              <div class="form-group">
                <label class="d-subheading">Preferred Regions & Circuits <span class="opt">(Select all that apply)</span>:</label>
                <div class="checkbox-matrix-2">
                  <label class="d-check-card">
                    <input type="checkbox" name="regions[]" value="Northern Historic Route (Lalibela, Axum, Gondar, Bahir Dar)" checked />
                    <span class="check-box-custom"></span>
                    <span class="check-text">
                      <strong>Northern Historic Route</strong>
                      <span class="check-desc">Lalibela rock-hewn churches, Axum stelae, Gondar castles, Lake Tana monasteries</span>
                    </span>
                  </label>

                  <label class="d-check-card">
                    <input type="checkbox" name="regions[]" value="Danakil Depression & Tigray Rock Churches" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">
                      <strong>Danakil Depression & Tigray Rock Churches</strong>
                      <span class="check-desc">Erta Ale active lava lake, Dallol hydro-thermal acid springs, Gheralta cliff churches</span>
                    </span>
                  </label>

                  <label class="d-check-card">
                    <input type="checkbox" name="regions[]" value="Omo Valley & Southern Cultural Circuit (Arba Minch, Dorze, Turmi)" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">
                      <strong>Omo Valley & Southern Cultural Circuit</strong>
                      <span class="check-desc">Hamer bull-jumping, Mursi lip plates, Karo body painting, Dorze bamboo huts</span>
                    </span>
                  </label>

                  <label class="d-check-card">
                    <input type="checkbox" name="regions[]" value="Bale Mountains & Rift Valley Lakes" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">
                      <strong>Bale Mountains & Rift Valley Lakes</strong>
                      <span class="check-desc">Sanetti Plateau, endemic Ethiopian Wolf, Harenna cloud forest, Great Rift birdlife</span>
                    </span>
                  </label>

                  <label class="d-check-card">
                    <input type="checkbox" name="regions[]" value="Harar & Eastern Ethiopia" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">
                      <strong>Harar & Eastern Ethiopia</strong>
                      <span class="check-desc">Walled Islamic city of Jugol, Arthur Rimbaud house, nocturnal hyena feeding</span>
                    </span>
                  </label>

                  <label class="d-check-card">
                    <input type="checkbox" name="regions[]" value="Addis Ababa City & Day Excursions (Wonchi, Debre Libanos)" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">
                      <strong>Addis Ababa City & Day Excursions</strong>
                      <span class="check-desc">National Museum (Lucy), Entoto panoramic ridge, Wonchi crater lake, Blue Nile Gorge</span>
                    </span>
                  </label>
                </div>
              </div>

              <!-- Tour Style & Pace -->
              <div class="form-group" style="margin-top: 1.5rem;">
                <label class="d-subheading">Tour Style & Pace <span class="opt">(Select all that apply)</span>:</label>
                <div class="checkbox-matrix-3">
                  <label class="d-check-card compact">
                    <input type="checkbox" name="tourStyle[]" value="Private Tailor-Made" checked />
                    <span class="check-box-custom"></span>
                    <span class="check-text"><strong>Private Tailor-Made</strong></span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="tourStyle[]" value="Small Group" />
                    <span class="check-box-custom"></span>
                    <span class="check-text"><strong>Small Group</strong></span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="tourStyle[]" value="4x4 Overland" checked />
                    <span class="check-box-custom"></span>
                    <span class="check-text"><strong>4x4 Overland</strong></span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="tourStyle[]" value="Cultural & Photography" />
                    <span class="check-box-custom"></span>
                    <span class="check-text"><strong>Cultural & Photography</strong></span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="tourStyle[]" value="Trekking & Wildlife" />
                    <span class="check-box-custom"></span>
                    <span class="check-text"><strong>Trekking & Wildlife</strong></span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="tourStyle[]" value="Vehicle & Driver Only" />
                    <span class="check-box-custom"></span>
                    <span class="check-text"><strong>Vehicle & Driver Only</strong></span>
                  </label>
                </div>
              </div>

              <!-- Optional Pre-configured Master Tour Linkage -->
              <div class="form-group" style="margin-top: 1.25rem;">
                <label for="tourName" class="d-label">Base Master Catalogue Itinerary <span class="opt">(Optional - select if building upon a catalogue tour)</span></label>
                <select id="tourName" name="tourName" class="d-select">
                  <option value="Custom Bespoke Itinerary">-- Fully Custom / Tailor-Made Itinerary --</option>
                  {allTours.map(t => (
                    <option value={t.title}>{t.title} ({t.duration})</option>
                  ))}
                </select>
              </div>
            </div>
          </div>

          <!-- ==================================================================== -->
          <!-- 4. ACCOMMODATION, TRANSPORT & MEAL PLAN PREFERENCES -->
          <!-- ==================================================================== -->
          <div class="dossier-section">
            <div class="dossier-section-title">
              <span class="sec-num">4.</span> ACCOMMODATION, TRANSPORT & MEAL PLAN PREFERENCES
            </div>
            <div class="dossier-section-body">
              <div class="form-grid-2">
                <!-- Accommodation Standard -->
                <div class="form-group">
                  <label class="d-subheading">Accommodation Standard <span class="opt">(Select all acceptable)</span>:</label>
                  <div class="checkbox-stack">
                    <label class="d-check-line">
                      <input type="checkbox" name="accommodation[]" value="Luxury / Boutique Lodges" checked />
                      <span class="check-box-custom"></span>
                      <span><strong>Luxury / Boutique Lodges</strong> (e.g. Limalimo, Mezena, Haile Resorts)</span>
                    </label>
                    <label class="d-check-line">
                      <input type="checkbox" name="accommodation[]" value="Mid-Range (3–4 Star)" checked />
                      <span class="check-box-custom"></span>
                      <span><strong>Mid-Range (3–4 Star)</strong> (Clean, comfortable, air-conditioned en-suite hotels)</span>
                    </label>
                    <label class="d-check-line">
                      <input type="checkbox" name="accommodation[]" value="Standard / Guesthouses" />
                      <span class="check-box-custom"></span>
                      <span><strong>Standard / Guesthouses</strong> (Authentic local community & regional guesthouses)</span>
                    </label>
                    <label class="d-check-line">
                      <input type="checkbox" name="accommodation[]" value="Expedition Camping" />
                      <span class="check-box-custom"></span>
                      <span><strong>Expedition Camping</strong> (Full wilderness mobile camp setup in Danakil / Simien / Suri)</span>
                    </label>
                  </div>
                </div>

                <!-- Room Configuration -->
                <div class="form-group">
                  <label class="d-subheading">Room Configuration:</label>
                  <div class="checkbox-stack">
                    <label class="d-check-line">
                      <input type="checkbox" name="roomConfig[]" value="Single" />
                      <span class="check-box-custom"></span>
                      <span><strong>Single Room</strong> (1 Bed, solo occupancy)</span>
                    </label>
                    <label class="d-check-line">
                      <input type="checkbox" name="roomConfig[]" value="Double" checked />
                      <span class="check-box-custom"></span>
                      <span><strong>Double Room</strong> (1 King / Queen bed for couples)</span>
                    </label>
                    <label class="d-check-line">
                      <input type="checkbox" name="roomConfig[]" value="Twin" checked />
                      <span class="check-box-custom"></span>
                      <span><strong>Twin Room</strong> (2 Separate single beds)</span>
                    </label>
                    <label class="d-check-line">
                      <input type="checkbox" name="roomConfig[]" value="Triple" />
                      <span class="check-box-custom"></span>
                      <span><strong>Triple Room</strong> (3 Separate beds or family suite)</span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="form-grid-2" style="margin-top: 1.25rem;">
                <!-- Preferred Meal Plan -->
                <div class="form-group">
                  <label class="d-subheading">Preferred Meal Plan:</label>
                  <div class="radio-stack-custom">
                    <label class="d-radio-line">
                      <input type="radio" name="mealPlan" value="Full Board (B, L, D)" checked />
                      <span><strong>Full Board (B, L, D)</strong> — Breakfast, Lunch & Dinner Included</span>
                    </label>
                    <label class="d-radio-line">
                      <input type="radio" name="mealPlan" value="Half Board (B & D)" />
                      <span><strong>Half Board (B & D)</strong> — Breakfast & Dinner Included</span>
                    </label>
                    <label class="d-radio-line">
                      <input type="radio" name="mealPlan" value="Bed & Breakfast" />
                      <span><strong>Bed & Breakfast</strong> — Breakfast only (Dine around locally)</span>
                    </label>
                  </div>
                </div>

                <!-- Domestic Flights -->
                <div class="form-group">
                  <label class="d-subheading">Domestic Flights (Include in Quote?):</label>
                  <div class="radio-stack-custom">
                    <label class="d-radio-line">
                      <input type="radio" name="domesticFlights" value="Yes (Ethiopian Airlines)" checked />
                      <span><strong>Yes (Ethiopian Airlines)</strong> — Booked via our corporate desk</span>
                    </label>
                    <label class="d-radio-line">
                      <input type="radio" name="domesticFlights" value="Overland Only" />
                      <span><strong>Overland Only</strong> — 100% scenic surface 4x4 expedition</span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="form-grid-2" style="margin-top: 1.25rem;">
                <div class="form-group">
                  <label for="budget" class="d-label">Estimated Budget per Person <span class="opt">(USD / EUR, excl. international flights)</span></label>
                  <input type="text" id="budget" name="budget" class="d-input" placeholder="e.g. $2,500 – $4,500 USD per person" />
                </div>
                <div class="form-group">
                  <label for="vehiclePreference" class="d-label">Vehicle Preference <span class="opt">(e.g., 4x4 Land Cruiser, Minibus, Coaster)</span></label>
                  <input type="text" id="vehiclePreference" name="vehiclePreference" class="d-input" placeholder="e.g. Toyota Land Cruiser 76/79 Series or Toyota HiAce" />
                </div>
              </div>
            </div>
          </div>

          <!-- ==================================================================== -->
          <!-- 5. DIETARY REQUIREMENTS, HEALTH & MOBILITY NEEDS -->
          <!-- ==================================================================== -->
          <div class="dossier-section">
            <div class="dossier-section-title">
              <span class="sec-num">5.</span> DIETARY REQUIREMENTS, HEALTH & MOBILITY NEEDS
            </div>
            <div class="dossier-section-body">
              <div class="form-group">
                <label class="d-subheading">Dietary Preferences & Restrictions <span class="opt">(Select all that apply)</span>:</label>
                <div class="checkbox-matrix-4">
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="No Restrictions" checked />
                    <span class="check-box-custom"></span>
                    <span class="check-text">No Restrictions</span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="Vegetarian" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">Vegetarian</span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="Vegan" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">Vegan (Fasting Food)</span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="Gluten-Free" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">Gluten-Free</span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="Halal" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">Halal</span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="Kosher" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">Kosher</span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="Dairy-Free / Lactose Intolerant" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">Dairy-Free</span>
                  </label>
                  <label class="d-check-card compact">
                    <input type="checkbox" name="dietary[]" value="Nut / Severe Food Allergy" />
                    <span class="check-box-custom"></span>
                    <span class="check-text">Nut / Severe Allergy</span>
                  </label>
                </div>
              </div>

              <div class="form-grid-2" style="margin-top: 1.25rem;">
                <div class="form-group">
                  <label for="dietaryNotes" class="d-label">Specify Food Allergies or Medical Dietary Details:</label>
                  <textarea id="dietaryNotes" name="dietaryNotes" rows="2" class="d-textarea" placeholder="Detail any specific allergy triggers, severity, or dietary preferences for field chef planning..."></textarea>
                </div>
                <div class="form-group">
                  <label for="healthMobilityNotes" class="d-label">Mobility, Altitude Sensitivity, or Medical Conditions to Note:</label>
