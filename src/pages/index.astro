<script>
  // About Us Tab Switcher Logic
  const tabBtns = document.querySelectorAll('.about-tab-btn');
  const tabPanels = document.querySelectorAll('.about-tab-panel');
  const switchPillarBtns = document.querySelectorAll('.js-switch-tab');

  function activateAboutTab(targetId, shouldScroll = false) {
    if (!targetId) return;

    tabBtns.forEach(btn => {
      const isTarget = btn.getAttribute('data-tab') === targetId;
      btn.classList.toggle('active', isTarget);
      btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');

      const actionIndicator = btn.querySelector('.tab-action-indicator');
      if (actionIndicator) {
        actionIndicator.textContent = isTarget ? '● Active View' : 'Tap to View →';
      }
    });

    tabPanels.forEach(panel => {
      const isTarget = panel.id === `panel-${targetId}`;
      panel.classList.toggle('active', isTarget);
    });

    if (shouldScroll && window.innerWidth <= 768) {
      const activePanel = document.getElementById(`panel-${targetId}`);
      if (activePanel) {
        const yOffset = -90;
        const yPos = activePanel.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: yPos, behavior: 'smooth' });
      }
    }
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      activateAboutTab(targetId, true);
    });
  });

  switchPillarBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-next');
      activateAboutTab(targetId, true);
    });
  });

  // License Modal Lightbox Logic
  const licenseModal = document.getElementById('licenseModal');
  const openLicenseBtns = document.querySelectorAll('.js-open-license-modal');
  const closeLicenseBtn = licenseModal?.querySelector('.license-modal-close');

  function openLicense() {
    if (licenseModal) {
      licenseModal.classList.add('active');
      licenseModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLicense() {
    if (licenseModal) {
      licenseModal.classList.remove('active');
      licenseModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  openLicenseBtns.forEach(btn => btn.addEventListener('click', openLicense));
  closeLicenseBtn?.addEventListener('click', closeLicense);

  licenseModal?.addEventListener('click', (e) => {
    if (e.target === licenseModal) {
      closeLicense();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && licenseModal?.classList.contains('active')) {
      closeLicense();
    }
  });
</script>
