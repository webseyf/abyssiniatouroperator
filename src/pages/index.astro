<script>
  // Interactive Accordion for Section 4 (Compact Height as requested)
  document.querySelectorAll('.about-acc-card .acc-header').forEach(header => {
    header.addEventListener('click', () => {
      const card = header.closest('.about-acc-card');
      const isActive = card?.classList.contains('active');
      
      document.querySelectorAll('.about-acc-card').forEach(c => {
        c.classList.remove('active');
        const icon = c.querySelector('.acc-icon');
        if (icon) icon.innerHTML = '&plus;';
        const body = c.querySelector('.acc-body') as HTMLElement;
        if (body) body.style.display = 'none';
      });

      if (!isActive && card) {
        card.classList.add('active');
        const icon = card.querySelector('.acc-icon');
        if (icon) icon.innerHTML = '&minus;';
        const body = card.querySelector('.acc-body') as HTMLElement;
        if (body) body.style.display = 'block';
      }
    });
  });

  // Lightbox Modal for Ministry of Tourism License
  const licenseModal = document.getElementById('licenseModal');
  const closeBtn = document.querySelector('.license-modal-close');

  document.querySelectorAll('.js-open-license-modal').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (licenseModal) {
        licenseModal.classList.add('active');
        licenseModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    if (licenseModal) {
      licenseModal.classList.remove('active');
      licenseModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });

  licenseModal?.addEventListener('click', (e) => {
    if (e.target === licenseModal) {
      licenseModal.classList.remove('active');
      licenseModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });
</script>
