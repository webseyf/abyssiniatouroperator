---
import MainLayout from '../layouts/MainLayout.astro';
import { allTours } from '../data/tours';
import { siteConfig } from '../config/site';

// Select the 4 Flagship Expeditions matching the client's reference guideline
const flagshipTours = [
  {
    title: "8 Historic North & Lalibela",
    category: "Cultural Heritage & UNESCO Monoliths",
    route: "Addis Ababa ➔ Bahir Dar ➔ Gondar ➔ Simien ➔ Axum ➔ Lalibela",
    slug: "8-day-historic-north-lalibela-unesco-circuit",
    image: "/images/destinations/lalibela-st-george.jpg",
    highlights: [
      "12th-century UNESCO monoliths in Lalibela, Gondar castles, and Tigray cliff churches",
      "Trek Simien Mountains to spot endemic Gelada baboons and Walia ibex",
      "Private boat cruise to ancient island monasteries of Lake Tana"
    ]
  },
  {
    title: "4 Danakil Depression & Erta Ale",
    category: "Extreme Desert Expedition & Active Volcanoes",
    route: "Semera ➔ Afdera ➔ Erta Ale Volcano ➔ Dallol",
    slug: "4-day-danakil-depression-erta-ale-lava-lake",
    image: "/images/destinations/danakil-dallol.jpg",
    highlights: [
      "Trek to the active glowing lava lake rim of Erta Ale volcano",
      "Photograph the surreal neon hydrothermal acid springs of Dallol",
      "Heavy-duty Toyota 4x4 fleet with dedicated expedition cooks"
    ]
  },
  {
    title: "South Omo Valley Tribal Safari",
    category: "Ethnographic Safari & Cultural Photography",
    route: "Arba Minch ➔ Jinka ➔ Mago National Park ➔ Turmi",
    slug: "7-day-omo-valley-tribal-cultural-photography-safari",
    image: "/images/destinations/mursi-tribe.jpg",
    highlights: [
      "Respectful cultural encounters with Hamer, Mursi, and Karo communities",
      "Attend authentic Hamer bull jumping ceremony when scheduled",
      "Private base safari with experienced native cultural guides"
    ]
  },
  {
    title: "Nature & Birdwatching",
    category: "Endemic Wildlife & Afro-Alpine Safari",
    route: "Addis Ababa ➔ Awash ➔ Bale Mountains ➔ Rift Lakes",
    slug: "7-day-bale-mountains-wilderness-ethiopian-wolf-safari",
    image: "/images/destinations/bale-mountains-wolf.jpg",
    highlights: [
      "Search for the rare Ethiopian Wolf on the high Sanetti Plateau",
      "Photograph endemic Mountain Nyala, Menelik's Bushbuck, and Rift waterbirds",
      "Pristine afro-alpine and Harenna cloud forest habitats"
    ]
  }
];
---

<MainLayout 
  title="Abyssinian Tour Operator | Direct Inbound DMC & Tour Operator in Ethiopia"
  description="Licensed Ethiopian DMC based in Addis Ababa. 20+ years native field leadership, direct heavy-duty Toyota 4x4 fleet ownership, white-label B2B tariffs, and 20 master itineraries across Lalibela, Danakil, Omo Valley, and Simien Mountains."
>
  <!-- ==================================================================== -->
  <!-- HERO SECTION -->
  <!-- ==================================================================== -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-container">
      <div class="hero-content-box">
        <p class="hero-eyebrow">
          Direct Inbound DMC | 20+ Years Native Field Leadership | Addis Ababa, Ethiopia
        </p>

        <h1 class="hero-main-title">
          Experience Ethiopia with Native Field Leadership
        </h1>

        <p class="hero-subtext">
          Over 20 years of direct ground execution across historic monolithic churches, Danakil active lava lakes, and Omo Valley ethnographic safaris.
        </p>

        <div class="hero-badges-row">
          <button type="button" class="badge-item js-open-license-modal" title="Click to view official Ministry of Tourism license certificate">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E5C158" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>Officially Licensed Inbound DMC &bull; Ministry of Tourism Accredited (Click to Verify)</span>
          </button>
        </div>

        <div class="hero-actions">
          <a href="/tours" class="btn btn-hero-gold">
            [ Explore All 20 Itineraries ]
          </a>
          <a href="/b2b" class="btn btn-hero-green">
            [ Request B2B Confidential Tariffs ]
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================================== -->
  <!-- DIRECT DMC VALUE PROPOSITION (Trust & Authority Bar - Red-Circled Section) -->
  <!-- ==================================================================== -->
  <section class="trust-bar-section">
    <div class="container">
      <div class="dmc-value-card">
        <!-- Title matching client reference (Without section numbering) -->
        <h2 class="dmc-value-header">
          DIRECT DMC VALUE PROPOSITION (Trust & Authority Bar)
        </h2>

        <!-- 4 Rows with Icons & Explanations, Fully Linked -->
        <div class="dmc-rows-list">
          <!-- Row 1: Direct Wholesale NET Rates -->
          <a href="/b2b" class="dmc-row-item" title="Explore B2B Wholesale NET Rates">
            <div class="dmc-col-left">
              <span class="dmc-icon-badge vehicle-icon">
                <!-- 4x4 Land Cruiser Icon -->
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM7.5 17c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                </svg>
              </span>
              <strong class="dmc-title">Direct Wholesale NET Rates</strong>
            </div>
            <div class="dmc-col-right">
              <span class="dmc-desc-icon money-icon">
                <!-- Money / Net Tariffs Icon -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                  <circle cx="12" cy="15" r="2"></circle>
                </svg>
              </span>
              <span class="dmc-desc-text">
                No middleman markups — direct Toyota Land Cruiser and fleet & lodge tariffs.
              </span>
            </div>
          </a>

          <!-- Row 2: 12-Hour Proposal Turnaround -->
          <a href="/contact-us" class="dmc-row-item" title="Request Custom Itinerary with 12-Hour Turnaround">
            <div class="dmc-col-left">
              <span class="dmc-icon-badge clock-icon">
                <!-- Fast Clock / Stopwatch Icon -->
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </span>
              <strong class="dmc-title">12-Hour Proposal Turnaround</strong>
            </div>
            <div class="dmc-col-right">
              <span class="dmc-desc-icon doc-icon">
                <!-- Clipboard / Itinerary Drafting Icon -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                  <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                  <path d="M9 12h6"></path>
                  <path d="M9 16h6"></path>
                </svg>
              </span>
              <span class="dmc-desc-text">
                Fast, customized itinerary drafting & net quotes for B2C travelers & travel agents.
              </span>
            </div>
          </a>

          <!-- Row 3: Native Field Operations -->
          <a href="/about-us" class="dmc-row-item" title="Meet CEO Dessiew Abunie Dejenie & Ground Team">
            <div class="dmc-col-left">
              <span class="dmc-icon-badge shield-icon">
                <!-- Native Field Hat / Compass / Shield Icon -->
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
              </span>
              <strong class="dmc-title">Native Field Operations</strong>
            </div>
            <div class="dmc-col-right">
              <span class="dmc-desc-icon guide-icon">
                <!-- Guide / CEO Icon -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </span>
              <span class="dmc-desc-text">
                Led by CEO Dessiew Abunie Dejenie with 100% certified multi-lingual local guides.
              </span>
            </div>
          </a>

          <!-- Row 4: Full Turnkey Execution -->
          <a href="/travel-guide" class="dmc-row-item" title="View Turnkey Flight & Wilderness Logistics">
            <div class="dmc-col-left">
              <span class="dmc-icon-badge plane-icon">
                <!-- Airplane Icon -->
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
                </svg>
              </span>
              <strong class="dmc-title">Full Turnkey Execution</strong>
            </div>
            <div class="dmc-col-right">
              <span class="dmc-desc-icon tent-icon">
                <!-- Safari Tent / Wilderness Catering Icon -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 20 12 4 5 20h14Z"></path>
                  <path d="m12 4 4 16"></path>
                  <path d="m12 4-4 16"></path>
                </svg>
              </span>
              <span class="dmc-desc-text">
                Priority domestic flight bookings via Ethiopian Airlines & private wilderness catering.
              </span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================================== -->
  <!-- POPULAR FEATURED EXPEDITIONS -->
  <!-- ==================================================================== -->
  <section class="section-pad expeditions-section">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="flagship-main-title">
          POPULAR FEATURED EXPEDITIONS
        </h2>
        <p class="flagship-subtext">
          Explore our most requested private expeditions, meticulously crafted to balance cultural immersion, comfortable logistics, and authentic Ethiopian wonder.
        </p>
      </div>

      <!-- 4 Flagship Expedition Cards matching Client Guideline -->
      <div class="flagship-cards-grid">
        {flagshipTours.map(tour => (
          <article class="f-tour-card">
            <!-- Thumbnail Photo (Clickable to Tour Details) -->
            <a href={`/tours/${tour.slug}`} class="f-img-wrap" title={`View ${tour.title} details`}>
              <img src={tour.image} alt={tour.title} class="f-card-img" loading="lazy" />
            </a>

            <!-- Card Content Body -->
            <div class="f-body">
              <h3 class="f-title">
                <a href={`/tours/${tour.slug}`} class="f-title-link">
                  {tour.title}
                </a>
              </h3>
              
              <div class="f-meta-item">
                <span class="f-meta-label">Category:</span>
                <span class="f-meta-val">{tour.category}</span>
              </div>

              <div class="f-meta-item">
                <span class="f-meta-label">Route:</span>
                <span class="f-meta-val">{tour.route}</span>
              </div>

              <!-- Key Highlights -->
              <div class="f-highlights-block">
                <span class="f-hl-title">Key Highlights:</span>
                <ul class="f-hl-list">
                  {tour.highlights.map(hl => (
                    <li>{hl}</li>
                  ))}
                </ul>
              </div>

              <!-- Action Buttons -->
              <div class="f-actions">
                <a href={`/tours/${tour.slug}`} class="btn-f-view">
                  [ View Itinerary ]
                </a>
                <button 
                  type="button" 
                  class="btn-f-quote js-open-quote-modal" 
                  data-tour={tour.title}
                >
                  Get Quote
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- View All 20 Itineraries Action Button -->
      <div class="view-all-cta text-center" style="margin-top: 2.75rem;">
        <a href="/tours" class="btn btn-gold btn-lg">
          [ EXPLORE ALL 20 MASTER ITINERARIES ]
        </a>
      </div>
    </div>
  </section>

  <!-- ==================================================================== -->
  <!-- ABOUT ABYSSINIAN TOUR OPERATOR (Smart Authority Hub) -->
  <!-- ==================================================================== -->
  <section class="section-pad about-smart-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label">COMPANY PROFILE & TRUST AUDIT</span>
        <h2>ABOUT ABYSSINIAN TOUR OPERATOR</h2>
        <p>Direct native execution, authorized Ministry of Tourism competence, and two decades of field leadership.</p>
      </div>

      <!-- Quick Trust Metric Strip -->
      <div class="about-trust-strip">
        <div class="trust-stat-item">
          <span class="stat-number">20+</span>
          <span class="stat-label">Years Native Field Ops</span>
        </div>
        <div class="trust-stat-divider"></div>
        <div class="trust-stat-item">
          <span class="stat-number">100%</span>
          <span class="stat-label">Direct Ground Execution</span>
        </div>
        <div class="trust-stat-divider"></div>
        <div class="trust-stat-item">
          <span class="stat-number">12M ETB</span>
          <span class="stat-label">Registered Capital Standing</span>
        </div>
        <div class="trust-stat-divider"></div>
        <div class="trust-stat-item">
          <span class="stat-number">4x4</span>
          <span class="stat-label">Company-Owned Ground Fleet</span>
        </div>
      </div>

      <!-- Interactive Tab Guide Banner -->
      <div class="tabs-guide-banner text-center">
        <span class="guide-pulsing-badge">AUDIT OUR 4 CREDENTIAL PILLARS</span>
        <p class="guide-text">
          <span class="guide-hand">👉</span> <strong>Tap any button below</strong> to inspect our direct ground operations, leadership, 4x4 fleet, and legal license:
        </p>
      </div>

      <!-- Interactive Tab Selector (High-Affordance Clickable Cards) -->
      <div class="about-tabs-nav" role="tablist" aria-label="About Us Pillars">
        <button 
          class="about-tab-btn active" 
          role="tab" 
          aria-selected="true" 
          aria-controls="panel-dmc" 
          id="tab-dmc"
          data-tab="dmc"
        >
          <div class="tab-btn-inner">
            <span class="tab-index-badge">01</span>
            <span class="tab-icon">🏢</span>
            <div class="tab-title-col">
              <span class="tab-text">Direct Inbound DMC</span>
              <span class="tab-action-indicator">● Active View</span>
            </div>
          </div>
          <span class="tab-arrow-down" aria-hidden="true"></span>
        </button>

        <button 
          class="about-tab-btn" 
          role="tab" 
          aria-selected="false" 
          aria-controls="panel-founder" 
          id="tab-founder"
          data-tab="founder"
        >
          <div class="tab-btn-inner">
            <span class="tab-index-badge">02</span>
            <span class="tab-icon">👤</span>
            <div class="tab-title-col">
              <span class="tab-text">Founder Leadership</span>
              <span class="tab-action-indicator">Tap to View &rarr;</span>
            </div>
          </div>
          <span class="tab-arrow-down" aria-hidden="true"></span>
        </button>

        <button 
          class="about-tab-btn" 
          role="tab" 
          aria-selected="false" 
          aria-controls="panel-fleet" 
          id="tab-fleet"
          data-tab="fleet"
        >
          <div class="tab-btn-inner">
            <span class="tab-index-badge">03</span>
            <span class="tab-icon">🚙</span>
            <div class="tab-title-col">
              <span class="tab-text">Company 4x4 Fleet</span>
              <span class="tab-action-indicator">Tap to View &rarr;</span>
            </div>
          </div>
          <span class="tab-arrow-down" aria-hidden="true"></span>
        </button>

        <button 
          class="about-tab-btn" 
          role="tab" 
          aria-selected="false" 
          aria-controls="panel-license" 
          id="tab-license"
          data-tab="license"
        >
          <div class="tab-btn-inner">
            <span class="tab-index-badge">04</span>
            <span class="tab-icon">📜</span>
            <div class="tab-title-col">
              <span class="tab-text">Government License</span>
              <span class="tab-action-indicator">Tap to View &rarr;</span>
            </div>
          </div>
          <span class="tab-arrow-down" aria-hidden="true"></span>
        </button>
      </div>

      <!-- Tab Content Panels Container -->
      <div class="about-tab-panels">
        
        <!-- Panel 1: Direct Inbound DMC -->
        <div class="about-tab-panel active" id="panel-dmc" role="tabpanel" aria-labelledby="tab-dmc">
          <div class="panel-split-grid">
            <div class="panel-card-highlight">
              <div class="pch-badge">ADDIS ABABA HEADQUARTERS</div>
              <h3 class="pch-title">Direct Ground Execution Without Intermediaries</h3>
              <p class="pch-lead">
                Unlike aggregators that subcontract departures to third-party handlers, Abyssinian owns the fleet, employs the guides, and manages field operations directly from our Addis Ababa dispatch desk.
              </p>
              <div class="pch-features-list">
                <div class="pch-feature">
                  <span class="pch-check">✓</span>
                  <div>
                    <strong>Direct Wholesale NET Rates:</strong> Zero broker markups for B2B travel partners and private custom travelers.
                  </div>
                </div>
                <div class="pch-feature">
                  <span class="pch-check">✓</span>
                  <div>
                    <strong>12-Hour Proposal Turnaround:</strong> Comprehensive, itemized day-by-day itineraries and net quotations delivered rapidly.
                  </div>
                </div>
                <div class="pch-feature">
                  <span class="pch-check">✓</span>
                  <div>
                    <strong>Full Turnkey Handling:</strong> Priority Ethiopian Airlines domestic flight booking, private wilderness catering, and premier eco-lodges.
                  </div>
                </div>
              </div>
            </div>

            <div class="panel-card-content">
              <h4 class="pcc-subhead">Two Decades of Horn of Africa Excellence</h4>
              <p>
                Founded and headquartered in Addis Ababa, <strong>Abyssinian Tour Operator</strong> is an officially accredited, direct inbound Destination Management Company (DMC) in Ethiopia. For over 20 years, we have specialized in delivering high-end, private B2C expeditions and turnkey B2B ground handling across the northern historical circuit, Danakil Depression, and the South Omo Valley.
              </p>
              <p>
                Our clients and global travel agency partners deal straight with the decision-makers on the ground. We provide dedicated 24/7 flight monitoring, emergency satellite tracking, and personalized route customization.
              </p>
              <div class="panel-actions-row">
                <a href="/tours" class="btn btn-gold btn-sm">Explore All 20 Itineraries</a>
                <a href="/b2b" class="btn btn-outline btn-sm">B2B Partner Portal</a>
              </div>
            </div>
          </div>

          <!-- Next Pillar Footer Strip -->
          <div class="panel-nav-footer">
            <div class="pnav-status">
              <span class="pnav-dots"><span class="dot active"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
              <span class="pnav-text">Pillar 1 of 4: Direct Inbound DMC</span>
            </div>
            <button type="button" class="btn-next-pillar js-switch-tab" data-next="founder">
              <span>Next Pillar: 👤 Founder Leadership</span> &rarr;
            </button>
          </div>
        </div>

        <!-- Panel 2: Founder & Field Leadership -->
        <div class="about-tab-panel" id="panel-founder" role="tabpanel" aria-labelledby="tab-founder">
          <div class="panel-split-grid founder-split">
            <div class="founder-card-visual">
              <div class="founder-img-wrapper">
                <img 
                  src="/images/about/dessiew-abunie-dejenie.jpg" 
                  alt="Dessiew Abunie Dejenie - Founder and Managing Director" 
                  class="founder-main-photo" 
                  loading="lazy" 
                />
                <div class="founder-ribbon">Dessiew Abunie Dejenie &bull; Founder & CEO</div>
              </div>
              <div class="founder-quote-box">
                <span class="quote-mark">&ldquo;</span>
                <p>We built Abyssinian on direct native presence. We don't operate from behind foreign desks—we scout every trail, maintain our vehicles, and lead from the front.</p>
              </div>
            </div>

            <div class="founder-card-bio">
              <div class="pch-badge">20+ YEARS EXPEDITION LEADERSHIP</div>
              <h3 class="pch-title">Dessiew Abunie Dejenie</h3>
              <p class="pch-lead">
                Starting his career in the field, Dessiew has personally led hundreds of high-profile expeditions across the rugged Simien escarpment, the active lava fields of Danakil, and remote tribal communities of the South Omo.
              </p>
              <p>
                His deep-rooted relationships with local village elders, national park wardens, and heritage site guardians ensure that every Abyssinian departure operates with privileged access, strict safety protocols, and ethical community engagement.
              </p>
              <p>
                Today, Dessiew oversees all operations from our Addis Ababa headquarters, ensuring every guest and international agent receives 24/7 personal oversight and uncompromised field execution.
              </p>
              <div class="founder-badges-wrap">
                <span class="f-badge">Native Ethiopian Guide</span>
                <span class="f-badge">Expedition Logistics Specialist</span>
                <span class="f-badge">24/7 Operations Desk</span>
              </div>
              <div class="panel-actions-row">
                <a href="/about-us" class="btn btn-gold btn-sm">Read Full Founder Story</a>
                <a href="/contact-us" class="btn btn-outline btn-sm">Contact Dessiew Directly</a>
              </div>
            </div>
          </div>

          <!-- Pillar Navigation Footer Strip -->
          <div class="panel-nav-footer">
            <button type="button" class="btn-prev-pillar js-switch-tab" data-next="dmc">
              &larr; <span>Previous: Direct DMC</span>
            </button>
            <div class="pnav-status">
              <span class="pnav-dots"><span class="dot"></span><span class="dot active"></span><span class="dot"></span><span class="dot"></span></span>
              <span class="pnav-text">Pillar 2 of 4: Founder Leadership</span>
            </div>
            <button type="button" class="btn-next-pillar js-switch-tab" data-next="fleet">
              <span>Next: 🚙 Company-Owned 4x4</span> &rarr;
            </button>
          </div>
        </div>

        <!-- Panel 3: Company-Owned 4x4 Fleet -->
        <div class="about-tab-panel" id="panel-fleet" role="tabpanel" aria-labelledby="tab-fleet">
          <div class="fleet-smart-layout">
            <div class="fleet-photos-showcase">
              <div class="fleet-smart-item">
                <div class="fleet-photo-box">
                  <img 
                    src="/images/fleet/abyssinian-danakil-4x4-expedition.jpg" 
                    alt="Toyota Land Cruiser in Danakil Depression Expedition Spec" 
                    class="fleet-img" 
                    loading="lazy" 
                  />
                  <div class="fleet-overlay-tag">Expedition Spec: Danakil Desert Operations</div>
                </div>
                <div class="fleet-caption-bar">
                  <strong>Toyota Land Cruiser 76/78 Series:</strong> Fitted with heavy-duty roof expedition racks, high-mount snorkel, dual spare wheels, and desert-ready suspension.
                </div>
              </div>

              <div class="fleet-smart-item">
                <div class="fleet-photo-box">
                  <img 
                    src="/images/fleet/abyssinian-highland-4x4-convoy.jpg" 
                    alt="Toyota Land Cruiser 4WD Convoy Highland Escort" 
                    class="fleet-img" 
                    loading="lazy" 
                  />
                  <div class="fleet-overlay-tag">Cross-Country Convoy: Highland Mountain Escort</div>
                </div>
                <div class="fleet-caption-bar">
