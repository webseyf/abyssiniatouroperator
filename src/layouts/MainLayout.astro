---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const {
  title = "Abyssinian Tour Operator | Direct Inbound DMC & Tour Operator in Ethiopia",
  description = "Official licensed Ethiopian DMC & tour operator based in Addis Ababa. Direct 4x4 Land Cruiser fleet ownership, white-label B2B tariffs, and 20 master itineraries across Lalibela, Danakil, Omo Valley, and Simien Mountains.",
  image = "/images/home/hero-lalibela.jpg",
  canonical = Astro.url.href,
  type = 'website'
} = Astro.props;

const currentPath = Astro.url.pathname;
const fullImageUrl = image.startsWith('http') ? image : `${siteConfig.url}${image}`;
const canonicalUrl = canonical.startsWith('http') ? canonical : `${siteConfig.url}${canonical}`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": siteConfig.name,
  "legalName": siteConfig.legalName,
  "url": siteConfig.url,
  "logo": `${siteConfig.url}${siteConfig.logo.full}`,
  "image": fullImageUrl,
  "description": description,
  "telephone": siteConfig.contact.phone,
  "email": siteConfig.contact.emails.general,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.contact.address.street,
    "addressLocality": siteConfig.contact.address.city,
    "addressCountry": "ET"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 9.0222,
    "longitude": 38.7468
  },
  "founder": {
    "@type": "Person",
    "name": siteConfig.founder.name,
    "jobTitle": siteConfig.founder.title
  },
  "priceRange": "$$$",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Abyssinian Tour Operator" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Favicons with New Official Emblem -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#1B1713" />

    {currentPath === '/' && (
      <link rel="preload" as="image" href="/images/home/hero-lalibela.jpg" fetchpriority="high" />
    )}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body>
    <Header currentPath={currentPath} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    
    <QuoteModal />

    <!-- Floating WhatsApp Quick Dispatch (Bottom-Left) -->
    <WhatsAppButton />
  </body>
</html>

