# ==============================================================================
# Abyssinian Tour Operator — Production .htaccess for cPanel / Apache
# Canonical Domain: https://abyssiniatouroperator.com
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. DOMAIN MIGRATION: 301 Permanent Redirect from Old Domain
  # Old: abyssiniantouroperator.com (with an extra "n") -> New: abyssiniatouroperator.com
  # Preserves full URI path and query string parameters ($1, QSA)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^(www\.)?abyssiniantouroperator\.com$ [NC]
  RewriteRule ^(.*)$ https://abyssiniatouroperator.com/$1 [R=301,L,QSA]

  # ----------------------------------------------------------------------------
  # 2. CANONICAL HOSTNAME: Force non-www (https://abyssiniatouroperator.com)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.abyssiniatouroperator\.com$ [NC]
  RewriteRule ^(.*)$ https://abyssiniatouroperator.com/$1 [R=301,L,QSA]

  # ----------------------------------------------------------------------------
  # 3. FORCE HTTPS (SSL)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://abyssiniatouroperator.com/$1 [R=301,L,QSA]

  # ----------------------------------------------------------------------------
  # 4. REMOVE INDEX.PHP / LEGACY WORDPRESS URLS
  # ----------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^.*/index\.php
  RewriteRule ^(.*)index\.php$ /$1 [R=301,L]

  # ----------------------------------------------------------------------------
  # 5. LEGACY & HELPER ALIAS REDIRECTS
  # ----------------------------------------------------------------------------
  RewriteRule ^(tour-inquiry|inquiry)/?$ /contact-us [R=301,L]
  RewriteRule ^(reviews)/?$ /testimonials [R=301,L]

  # ----------------------------------------------------------------------------
  # 6. CLEAN URLS: Serve static .html files if exist
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # ----------------------------------------------------------------------------
  # 7. DIRECTORY FALLBACK: Serve index.html inside directories
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression (GZIP)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Fonts
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # CSS & JS
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Error Documents
ErrorDocument 404 /404.html

